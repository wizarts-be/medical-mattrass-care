---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { bedrijf } from '../../data/site.mjs';
---
<Base title="English version" description="Our English website is on its way. In the meantime, feel free to call or email us." noindex>
  <div lang="en">
    <PageHead title="English version" accent="coming soon." lede="Our English website is on its way. In the meantime, feel free to call or email us." tone="image" image={{ src: '/img/beeld/hero-2560.webp', mobile: '/img/beeld/hero-1280.webp' }}>
      <p class="contact"><a href={`tel:${bedrijf.telefoonHref}`}>{bedrijf.telefoon}</a><a href={`mailto:${bedrijf.email}`}>{bedrijf.email}</a></p>
      <a class="btn btn--light" href="/" lang="nl">Back to the Dutch site</a>
    </PageHead>
  </div>
</Base>
<style>
  .contact { display: grid; gap: 0.3rem; font-size: var(--step-1); }
  .contact a { color: var(--white); font-weight: 500; text-decoration-color: rgb(255 255 255 / 0.35); font-variant-numeric: tabular-nums; }
  .contact a:hover { text-decoration-color: var(--orange); }
</style>
