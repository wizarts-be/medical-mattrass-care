---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { bedrijf } from '../data/site.mjs';

// Opening hours per weekday, built from bedrijf.uren ("Maandag tot donderdag" + "Vrijdag").
const [maDo, vr] = bedrijf.uren.map(([, u]) => u);
const uren = [
  ['Maandag', maDo],
  ['Dinsdag', maDo],
  ['Woensdag', maDo],
  ['Donderdag', maDo],
  ['Vrijdag', vr],
];
const route = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${bedrijf.showroom.straat}, ${bedrijf.showroom.postcode} ${bedrijf.showroom.gemeente}`)}`;

// Every written request lands on the same form, with the right type already selected.
const aanvragen = [
  { href: '/offerte/', t: 'Offerte aanvragen', s: 'Uw prijs voor producten en aantallen' },
  { href: '/offerte/?type=staal', t: 'Staal aanvragen', s: 'Probeer een product eerst uit' },
  { href: '/offerte/?type=fiche', t: 'Technische fiche', s: 'Maten, samenstelling en normen' },
  { href: '/offerte/?type=maatwerk', t: 'Maatwerk bespreken', s: 'Uw eigen maat of opbouw' },
];
---
<Base title="Contact" description={`Contact Medical Mattress Care: ${bedrijf.telefoon}, ${bedrijf.email}. Showroom en afhalingen in ${bedrijf.showroom.gemeente}.`}>
  <!-- 1 · Phone and mail first; every written request one click away -->
  <section class="desk">
    <picture class="bg">
      <source media="(max-width: 900px)" srcset="/img/beeld/hero-1280.webp" />
      <img src="/img/beeld/hero-2560.webp" alt="" width="2560" height="1440" fetchpriority="high" />
    </picture>

    <div class="desk-in">
      <nav aria-label="Kruimelpad" class="crumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li><span aria-current="page">Contact</span></li>
        </ol>
      </nav>

      <div class="reach">
        <h1 class="visually-hidden">Contact</h1>
        <a class="number" href={`tel:${bedrijf.telefoonHref}`}>{bedrijf.telefoon}</a>
        <a class="address" href={`mailto:${bedrijf.email}`}>{bedrijf.email}</a>
        <button class="copy" type="button" data-copy={bedrijf.email} hidden>Kopieer e-mailadres</button>
        <span class="visually-hidden" role="status" data-copy-status></span>
      </div>

      <div class="ask">
        <h2>Liever schriftelijk?</h2>
        <ul>
          {aanvragen.map((a) => (
            <li>
              <a href={a.href}>
                <span class="ask-t">{a.t}</span>
                <span class="ask-s">{a.s}</span>
                <Icon name="arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 2 · Visit: address and hours side by side, on one line -->
  <section class="visit" aria-labelledby="visit-h">
    <h2 id="visit-h" class="title-xl">Kom langs in <em>{bedrijf.showroom.gemeente}.</em></h2>

    <div class="details">
      <div class="where">
        <h3>{bedrijf.showroom.label}</h3>
        <address>{bedrijf.showroom.straat}<br />{bedrijf.showroom.postcode} {bedrijf.showroom.gemeente}</address>
        <a class="btn" href={route} rel="noopener" target="_blank">Route plannen <Icon name="arrow" /></a>
      </div>

      <div class="when">
        <h3>Openingsuren</h3>
        <dl class="week">
          {uren.map(([dag, tijd]) => (
            <div>
              <dt>{dag}</dt>
              <dd>{tijd}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <p class="seat">
      <strong>Maatschappelijke zetel</strong>
      {bedrijf.naam}, {bedrijf.straat}, {bedrijf.postcode} {bedrijf.gemeente}. Ondernemingsnummer {bedrijf.btw}.
    </p>
  </section>
</Base>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.medical-mattress-care.com/' },
    { '@type': 'ListItem', position: 2, name: 'Contact' },
  ],
})} />

<script>
  // Copy the mail address: mailto often opens nothing on a work PC.
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const said = document.querySelector<HTMLElement>('[data-copy-status]');
  if (btn && navigator.clipboard) {
    const idle = btn.textContent ?? '';
    btn.hidden = false;
    let timer: ReturnType<typeof setTimeout>;
    btn.addEventListener('click', async () => {
      let msg = 'Gekopieerd';
      try { await navigator.clipboard.writeText(btn.dataset.copy!); btn.classList.add('done'); }
      catch { msg = 'Kopiëren lukte niet'; }
      btn.textContent = msg;
      if (said) said.textContent = msg;
      clearTimeout(timer);
      timer = setTimeout(() => { btn.textContent = idle; btn.classList.remove('done'); if (said) said.textContent = ''; }, 2200);
    });
  }
</script>

<style>
  /* ── Desk: the PU cover as ground, the request panel lapping over the edge ── */
  .desk { --lap: clamp(3rem, 6vw, 6rem); position: relative; z-index: 1; background: var(--night); color: var(--white); }
  .bg { position: absolute; inset: 0; overflow: hidden; }
  .bg img { width: 100%; height: 100%; object-fit: cover; object-position: 70% 40%; }
  .desk::before {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg, rgb(21 14 61 / 0.88) 0%, rgb(21 14 61 / 0.72) 55%, rgb(21 14 61 / 0.35) 100%);
  }
  .desk-in {
    position: relative; z-index: 2; display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-l) var(--space-xl);
    padding: var(--space-m) var(--gutter) var(--space-xl);
  }

  .crumbs { grid-column: 1 / -1; }
  .crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 0.6rem; font-size: var(--step--1); color: var(--on-indigo-muted); }
  .crumbs li + li::before { content: '/'; margin-right: 0.6rem; opacity: 0.6; }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { color: var(--white); text-decoration: underline; text-decoration-color: var(--orange); }
  .crumbs [aria-current] { color: var(--white); }

  /* Phone and mail are the page. Sized to their column, so neither can ever overflow it. */
  .reach { container-type: inline-size; display: grid; justify-items: start; align-content: center; padding-block: clamp(1rem, 4vw, 4rem); }
  .number {
    display: inline-flex; align-items: center; min-height: 2.75rem;
    font-family: var(--display); font-stretch: 112%; font-weight: 700; letter-spacing: -0.05em; line-height: 1;
    font-size: min(6rem, 13.5cqi); font-variant-numeric: tabular-nums; white-space: nowrap;
    color: var(--white); text-decoration: none; transition: color 0.25s var(--ease-out);
  }
  .address {
    display: inline-flex; align-items: center; min-height: 2.75rem; margin-top: clamp(0.5rem, 2cqi, 1.25rem);
    font-family: var(--display); font-stretch: 100%; font-weight: 600; letter-spacing: -0.025em; line-height: 1.1;
    font-size: min(2.9rem, 5.9cqi); white-space: nowrap;
    color: var(--orange-hot); text-decoration: none; transition: color 0.25s var(--ease-out);
  }
  @media (hover: hover) { .number:hover { color: var(--orange-hot); } .address:hover { color: var(--white); } }
  .number:focus-visible, .address:focus-visible { outline-offset: 6px; }

  .copy {
    min-height: 2.75rem; padding: 0; background: none; border: 0; cursor: pointer;
    font-size: var(--step--1); font-weight: 500; color: var(--on-indigo-muted);
    text-decoration: underline; text-decoration-color: rgb(255 255 255 / 0.35); text-underline-offset: 0.25em;
  }
  .copy[hidden] { display: none; }
  .copy:hover { color: var(--white); text-decoration-color: var(--orange-hot); }
  .copy.done { color: var(--white); text-decoration: none; }

  /* Request panel */
  .ask {
    align-self: end; margin-bottom: calc(-1 * (var(--space-xl) + var(--lap)));
    background: var(--white); color: var(--ink);
    padding: var(--space-m) var(--space-m) 0.5rem;
    box-shadow: 0 24px 60px -24px rgb(21 14 61 / 0.45);
  }
  .ask h2 { font-size: var(--step-2); font-weight: 700; margin-bottom: 0.9rem; }
  .ask ul { list-style: none; padding: 0; }
  .ask li { border-top: 1px solid var(--sheet-line); }
  .ask a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 1rem; align-items: center;
    padding: 0.95rem 0; color: inherit; text-decoration: none;
  }
  .ask-t { font-weight: 600; font-size: var(--step-1); line-height: 1.2; color: var(--ink); transition: color 0.2s var(--ease-out); }
  .ask-s { grid-row: 2; font-size: var(--step--1); color: var(--muted); }
  .ask a :global(svg) { grid-column: 2; grid-row: 1 / span 2; width: 1.25rem; height: 1.25rem; color: var(--orange-deep); transition: transform 0.35s var(--ease-out); }
  @media (hover: hover) {
    .ask a:hover .ask-t { color: var(--orange-deep); }
    .ask a:hover :global(svg) { transform: translateX(4px); }
  }

  /* ── Visit: one title, then address and hours starting on the same line ── */
  .visit { padding: var(--space-xl) var(--gutter); background: var(--white); }
  .visit .title-xl { max-width: 7em; }
  .details {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-l) var(--space-xl);
    margin-top: var(--space-l); padding-top: var(--space-m); border-top: 2px solid var(--ink);
  }
  .details h3 { font-size: var(--step-1); font-weight: 700; margin-bottom: 1.1rem; }
  .where { display: grid; justify-items: start; align-content: start; }
  address { font-style: normal; color: var(--ink); font-size: var(--step-2); line-height: 1.25; letter-spacing: -0.015em; margin-bottom: 1.5rem; }

  .week { display: grid; }
  .week div { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.7rem; border-top: 1px solid var(--sheet-line); }
  .week div:last-child { border-bottom: 1px solid var(--sheet-line); }
  .week dt { color: var(--ink); font-weight: 500; }
  .week dd { margin: 0; color: var(--text); font-variant-numeric: tabular-nums; white-space: nowrap; }

  .seat { margin-top: var(--space-l); color: var(--muted); font-size: var(--step--1); line-height: 1.6; }
  .seat strong { display: block; color: var(--ink); font-weight: 600; }

  /* ── One column: contact first, panel in the flow, nothing lapping ── */
  @media (max-width: 1100px) {
    .desk-in { grid-template-columns: minmax(0, 1fr); padding-bottom: var(--gutter); }
    .ask { margin-bottom: 0; box-shadow: none; }
    .desk::before { background: rgb(21 14 61 / 0.8); }
  }
  @media (max-width: 760px) {
    .details { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 520px) {
    .ask { padding-inline: 1.1rem; }
    .visit .btn { width: 100%; justify-content: space-between; }
  }
</style>
