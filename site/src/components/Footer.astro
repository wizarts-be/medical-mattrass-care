---
import Icon from './Icon.astro';
import { bedrijf } from '../data/site.mjs';
import { categorieen, categorieUrl } from '../lib/catalogus.mjs';
const jaar = new Date().getFullYear();
const [maDo, vr] = bedrijf.uren.map(([, u]) => u);
---
<footer class="site-footer">
  <div class="wrap top">
    <div class="brand">
      <a href="/" class="logo" aria-label="Medical Mattress Care, naar de startpagina">
        <img src="/logo/mmc-logo-wit.svg" alt="" width="160" height="80" />
      </a>
      <p class="say">Matrassen, kussens en hulpstukken voor de zorg.</p>
      <p class="since">Vlaams familiebedrijf sinds {bedrijf.opgericht}.</p>
    </div>

    <div class="reach">
      <a class="tel" href={`tel:${bedrijf.telefoonHref}`}>{bedrijf.telefoon}</a>
      <a class="mail" href={`mailto:${bedrijf.email}`}>{bedrijf.email}</a>
      <a class="quote" href="/offerte/">Offerte aanvragen <Icon name="arrow" /></a>
    </div>
  </div>

  <div class="wrap cols">
    <nav aria-labelledby="f-prod">
      <h2 id="f-prod">Producten</h2>
      <ul class="two">
        {categorieen.map((c) => (<li><a href={categorieUrl(c)}>{c.naam}</a></li>))}
      </ul>
    </nav>

    <nav aria-labelledby="f-mmc">
      <h2 id="f-mmc">MMC</h2>
      <ul>
        <li><a href="/mmc-210-pu-hoes/">De MMC 210 PU-hoes</a></li>
        <li><a href="/maatwerk/">Maatwerk</a></li>
        <li><a href="/kwaliteit/">Kwaliteit en certificaten</a></li>
        <li><a href="/over-mmc/">Over MMC</a></li>
        <li><a href="/offerte/?type=staal">Staal aanvragen</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <div>
      <h2>{bedrijf.showroom.label}</h2>
      <address>{bedrijf.showroom.straat}<br />{bedrijf.showroom.postcode} {bedrijf.showroom.gemeente}</address>
      <p class="hours">Ma tot do {maDo}<br />Vr {vr}</p>
    </div>
  </div>

  <div class="wrap legal">
    <p>© {jaar} {bedrijf.naam}, {bedrijf.straat}, {bedrijf.postcode} {bedrijf.gemeente}. ON {bedrijf.btw}</p>
    <ul>
      <li><a href="/privacybeleid/">Privacy</a></li>
      <li><a href="/cookiebeleid/">Cookies</a></li>
      <li><a href="/disclaimer/">Disclaimer</a></li>
    </ul>
    <ul class="lang" aria-label="Taal">
      <li><a href="/" lang="nl" aria-current="true">NL</a></li>
      <li><a href="/fr/" lang="fr">FR</a></li>
      <li><a href="/en/" lang="en">EN</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { background: var(--night); color: var(--on-indigo-muted); padding-block: var(--space-xl) var(--space-m); }
  a { color: inherit; text-decoration: none; }

  /* ── Top: who we are left, how to reach us right ── */
  /* top and columns share one grid, so the phone number sits right above the showroom */
  .top, .cols { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1.3fr); column-gap: var(--space-m); }
  .top { row-gap: var(--space-l); align-items: end; padding-bottom: var(--space-l); }
  .brand { grid-column: 1 / 3; }
  .reach { grid-column: 3; }
  .brand { display: grid; gap: 0.9rem; justify-items: start; }
  .logo img { width: 9rem; height: auto; display: block; margin-bottom: 0.6rem; }
  .say { font-family: var(--display); font-stretch: 112%; font-weight: 700; font-size: var(--step-3); letter-spacing: -0.045em; line-height: 1; color: var(--white); max-width: 18ch; text-wrap: balance; }
  .since { font-size: var(--step-0); }

  .reach { display: grid; gap: 0.5rem; justify-items: start; }
  .tel { font-family: var(--display); font-stretch: 112%; font-weight: 700; font-size: var(--step-3); letter-spacing: -0.04em; line-height: 1; color: var(--white); font-variant-numeric: tabular-nums; white-space: nowrap; transition: color 0.25s var(--ease-out); }
  .mail { font-size: var(--step-1); color: var(--on-indigo); overflow-wrap: anywhere; }
  .quote { display: inline-flex; align-items: center; gap: 0.5em; margin-top: 0.9rem; font-weight: 600; color: var(--orange); }
  .quote :global(svg) { width: 1em; height: 1em; transition: transform 0.35s var(--ease-out); }
  @media (hover: hover) {
    .tel:hover { color: var(--orange); }
    .mail:hover { color: var(--white); text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 0.2em; }
    .quote:hover :global(svg) { transform: translateX(3px); }
  }

  /* ── Columns: one rule across, three groups under it ── */
  .cols {
    row-gap: var(--space-l);
    padding-top: var(--space-l); border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  h2 { font-family: var(--text-face); font-stretch: 100%; font-size: var(--step--1); font-weight: 600; letter-spacing: 0; color: var(--white); margin-bottom: 1rem; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
  .two { grid-template-columns: repeat(2, minmax(0, max-content)); column-gap: var(--space-l); }
  .cols a { font-size: var(--step-0); }
  .cols a:hover { color: var(--white); text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 0.2em; }
  address { font-style: normal; font-size: var(--step-0); color: var(--on-indigo); line-height: 1.5; }
  .hours { margin-top: 0.9rem; font-size: var(--step-0); line-height: 1.5; font-variant-numeric: tabular-nums; }

  /* ── Legal ── */
  .legal {
    margin-top: var(--space-xl); padding-top: var(--space-m); border-top: 1px solid rgb(255 255 255 / 0.12);
    display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; align-items: center; font-size: var(--step--1);
  }
  .legal p { margin-right: auto; }
  .legal ul { display: flex; gap: 1.25rem; }
  .legal a:hover { color: var(--white); }
  .lang a[aria-current] { color: var(--orange); }

  /* Stack before the phone number gets wider than its column */
  @media (max-width: 1100px) {
    .top { grid-template-columns: 1fr; align-items: start; }
    .brand, .reach { grid-column: 1; }
    .cols { grid-template-columns: 1fr 1fr; }
    .cols > :first-child { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .cols { grid-template-columns: 1fr; }
    .two { grid-template-columns: 1fr 1fr; column-gap: 1rem; }
    .tel { white-space: normal; }
  }
</style>
