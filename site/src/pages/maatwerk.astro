---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ProductCard from '../components/ProductCard.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Icon from '../components/Icon.astro';
import { zichtbaar } from '../lib/catalogus.mjs';

const wat = [
  { t: 'Matrassen', d: 'Lengte, breedte en dikte, en de opbouw: koudschuim, traagschuim en densiteit.' },
  { t: 'Hulpstukken', d: 'Cilinders, wiggen en zitkussens in de maat van uw bed of rolstoel.' },
  { t: 'Hoofdkussens', d: 'De MMC PUP 23 in een andere maat.' },
  { t: 'Hoezen', d: 'De MMC 210 PU-hoes op maat van uw bestaande matrassen.' },
];
const stappen = [
  { t: 'U stuurt de maten.', d: 'Samen met het gebruik: wie ligt of zit erop, hoe lang, op welk bed of in welke rolstoel.' },
  { t: 'Wij stellen een opbouw voor.', d: 'Schuimsoort, densiteit en hoes, met een offerte. Op vraag eerst een staal.' },
  { t: 'Wij maken en leveren.', d: 'In ons Vlaams productiehuis.' },
];
const voorbeelden = zichtbaar.filter((p) => p.maatwerk && ['mmc-v10', 'mmc-flex', 'mmc-cg-02', 'mmc-zp-05', 'mmc-km-14'].includes(p.slug));
---
<Base title="Maatwerk" description="Medische matrassen, kussens en hulpstukken op maat. Medical Mattress Care maakt ze in de opbouw en maat die uw instelling nodig heeft.">
  <PageHead title="Zit het er niet bij?" accent="Wij maken het." lede="MMC levert matrassen, kussens en hulpstukken in opbouw en maat naar uw wens. In ons eigen Vlaams productiehuis." crumbs={[{ label: 'Maatwerk' }]}>
    <a class="btn" href="/offerte/?type=maatwerk">Maatwerk aanvragen <Icon name="arrow" /></a>
  </PageHead>

  <section class="band band--white build" aria-labelledby="opbouw">
    <figure class="layers">
      <img src="/img/beeld/bed-layers.webp" alt="Een matras uit elkaar gehaald in lagen: hoes, traagschuim en koudschuim" width="1600" height="1000" loading="lazy" />
    </figure>
    <div class="build-copy">
      <h2 id="opbouw" class="title-xl">U kiest de maat.<br />Wij de opbouw.</h2>
      <p>Lengte, breedte en dikte. Koudschuim, traagschuim en hun densiteit. En de hoes die erbij past. Wij stellen voor wat werkt voor wie erop ligt of zit.</p>
    </div>
  </section>

  <section class="band band--tall band--sheet" aria-labelledby="wat">
    <h2 id="wat" class="title-xl what-title">Wat kan op maat.</h2>
    <dl class="ruled">
      {wat.map((w) => (<div><dt>{w.t}</dt><dd>{w.d}</dd></div>))}
    </dl>
  </section>

  <section class="band band--tall band--ink" aria-labelledby="zo">
    <h2 id="zo" class="title-xl steps-title">Zo werkt het.</h2>
    <ol class="steps">
      <span class="steps-line" aria-hidden="true"></span>
      {stappen.map((s, i) => (
        <li>
          <span class="step-no">{i + 1}</span>
          <strong>{s.t}</strong>
          <span>{s.d}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="band band--white" aria-labelledby="ook">
    <div class="split-head">
      <h2 id="ook" class="title-xl">Ook op maat<br />verkrijgbaar.</h2>
      <p>Een paar producten die we vaak in een andere maat of opbouw maken.</p>
    </div>
    <ul class="grid-cards">{voorbeelden.map((p) => <ProductCard p={p} />)}</ul>
  </section>

  <QuoteBand lines={['Stuur ons', 'uw maten.']} text="Lengte, breedte, dikte en het gebruik. Wij komen terug met een opbouw en een prijs." href="/offerte/?type=maatwerk" label="Maatwerk aanvragen" />
</Base>

<style>
  .build { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-l) var(--space-xl); align-items: center; padding-top: 0; }
  .layers { margin-left: calc(var(--gutter) * -1); }
  .layers img { width: 100%; height: auto; }
  .build-copy { display: grid; gap: 1.4rem; }
  .build-copy p { color: var(--muted); font-size: var(--step-1); line-height: 1.5; max-width: 36ch; }
  @media (max-width: 900px) { .build { grid-template-columns: 1fr; } .layers { margin-inline: calc(var(--gutter) * -1); } }

  .what-title, .steps-title { margin-bottom: var(--space-l); }
  .steps { list-style: none; padding: 0; position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-m); }
  .steps-line { position: absolute; left: 0; right: 0; top: 1.3rem; height: 1px; background: rgb(255 255 255 / 0.18); }
  .steps li { position: relative; display: grid; gap: 0.5rem; align-content: start; }
  .step-no { width: 2.6rem; height: 2.6rem; display: grid; place-items: center; background: var(--orange); color: var(--ink); font-weight: 600; margin-bottom: 0.8rem; font-variant-numeric: tabular-nums; }
  .steps strong { font-family: var(--display); font-stretch: 112%; font-weight: 680; font-size: var(--step-2); letter-spacing: -0.03em; line-height: 1.05; color: var(--white); }
  .steps li > span:last-child { color: var(--on-indigo-muted); max-width: 34ch; }
  @media (max-width: 800px) { .steps { grid-template-columns: 1fr; } .steps-line { display: none; } }
</style>
