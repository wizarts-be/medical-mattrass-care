---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import ProductCard from '../../../components/ProductCard.astro';
import QuoteBand from '../../../components/QuoteBand.astro';
import Icon from '../../../components/Icon.astro';
import { categorieen, perCategorie, categorieUrl } from '../../../lib/catalogus.mjs';

export function getStaticPaths() {
  return categorieen.filter((c) => perCategorie(c.slug).length).map((c) => ({ params: { categorie: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const items = perCategorie(c.slug);
const andere = categorieen.filter((x) => x.slug !== c.slug && perCategorie(x.slug).length);
const maatwerk = items.some((p) => p.maatwerk);
// Grid that always fills its rows: up to 4 products in one row; more in rows of 3 or 4,
// with the first product widened so the last row is never half empty.
const n = items.length;
const cols = n <= 4 ? n : n % 3 === 0 ? 3 : 4;
const rest = (n - 1) % cols;
const leadSpan = n <= 4 ? 1 : cols - rest; // rest 0 → the lead takes a full row
---
<Base title={c.lang ?? c.naam} description={`${c.lang ?? c.naam} van Medical Mattress Care. ${c.intro}`}>
  <PageHead title={c.lang ?? c.naam} lede={c.intro} crumbs={[{ href: '/producten/', label: 'Producten' }, { label: c.naam }]} compact>
    <div class="head-row">
      <p class="count"><strong>{n}</strong> {n === 1 ? 'product' : 'producten'}{maatwerk && <span>, ook op maat</span>}</p>
      <a class="btn" href="/offerte/">Offerte aanvragen <Icon name="arrow" /></a>
    </div>
  </PageHead>

  <section class="band band--sheet list" aria-label={`Alle ${c.naam.toLowerCase()}`}>
    <ul class="cards" style={`--cols:${cols}`}>
      {items.map((p, i) => (
        <ProductCard
          p={p}
          headingLevel="h2"
          variant={n <= 2 || (i === 0 && leadSpan > 1) ? 'feature' : 'card'}
          style={`--i:${i};${i === 0 && leadSpan > 1 ? `grid-column: span ${leadSpan}` : ''}`}
        />
      ))}
    </ul>
  </section>

  <nav class="band band--white others" aria-labelledby="andere">
    <h2 id="andere" class="title-xl">Ook in het gamma.</h2>
    <ul>
      {andere.map((x) => (<li><a href={categorieUrl(x)}><span>{x.naam}</span><span class="n">{perCategorie(x.slug).length}</span><Icon name="arrow" /></a></li>))}
    </ul>
  </nav>

  <QuoteBand />
</Base>

<style>
  .head-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .count { color: var(--muted); font-size: var(--step-0); }
  .count strong { color: var(--ink); font-weight: 700; font-variant-numeric: tabular-nums; }

  .list { padding-top: var(--space-m); }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  @media (prefers-reduced-motion: no-preference) {
    .cards > :global(li) { animation: card-in 0.8s var(--ease-out) both; animation-delay: calc(0.15s + var(--i, 0) * 0.06s); }
  }
  @keyframes card-in { from { opacity: 0; transform: translateY(1.5rem); } }
  @media (max-width: 1100px) { .cards { grid-template-columns: repeat(min(var(--cols), 3), minmax(0, 1fr)); } }
  @media (max-width: 900px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } .cards > :global(li) { grid-column: auto !important; } .cards > :global(.v-feature) { grid-column: 1 / -1 !important; } }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } }

  .others { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--space-l) var(--space-xl); align-items: start; }
  .others ul { list-style: none; padding: 0; display: grid; }
  .others a { display: grid; grid-template-columns: 1fr auto 1.2rem; gap: 1rem; align-items: center; padding: 1rem 0; border-top: 1px solid var(--sheet-line); text-decoration: none; color: var(--ink); font-family: var(--display); font-stretch: 112%; font-weight: 650; font-size: var(--step-1); letter-spacing: -0.02em; transition: color 0.25s var(--ease-out); }
  .others a > span:first-child { transition: transform 0.4s var(--ease-out); }
  .others li:last-child a { border-bottom: 1px solid var(--sheet-line); }
  .others .n { font-family: var(--text-face); font-weight: 400; font-size: var(--step--1); color: var(--muted); font-variant-numeric: tabular-nums; letter-spacing: 0; }
  .others a :global(svg) { width: 1.1rem; color: var(--ink); transition: transform 0.35s var(--ease-out), color 0.25s; }
  @media (hover: hover) { .others a:hover > span:first-child { transform: translateX(0.6rem); } .others a:hover :global(svg) { transform: translateX(4px); color: var(--orange-deep); } }
  @media (max-width: 900px) { .others { grid-template-columns: 1fr; } }
</style>
