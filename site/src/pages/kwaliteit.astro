---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Icon from '../components/Icon.astro';

const items = [
  { naam: 'ISO 14001', voor: 'Productiehuis', tekst: 'Milieumanagement. Het productiehuis draait op eigen groene stroom en beperkt afval tot een minimum.' },
  { naam: 'Fairsales', voor: 'Medical Mattress Care', tekst: 'Gecertificeerd sinds 10.01.2016: eerlijke handel, prijzen zonder verrassingen, dienst na verkoop en een dubbele klachtengarantie.', href: '/docs/fairsales-certificaat-2026.pdf', link: 'Certificaat 2026 (pdf)' },
  { naam: 'Centexbel 58974/B', voor: 'MMC 210 PU-hoes', tekst: 'Brandtest volgens BS 7175, resultaat Crib 5.' },
  { naam: 'Oeko-Tex standaard 100', voor: 'MMC 210 PU-hoes', tekst: 'Getest op schadelijke stoffen.' },
  { naam: 'ATCC #6538 en ASTM G 21-96', voor: 'MMC 210 PU-hoes', tekst: 'Resistent tegen Staphylococcus aureus en schimmels. MRSA-bestendig.' },
  { naam: 'Medisch hulpmiddel klasse I', voor: 'MMC V10', tekst: 'Volgens verordening (EU) 2017/745, norm EN 12182.', href: '/docs/mmc-v10-eu-conformiteitsverklaring.pdf', link: 'EU-conformiteitsverklaring (pdf)' },
  { naam: 'EN ISO 12952:2010', voor: 'MMC Bicolor', tekst: 'Brandveilig volgens de sigarettentest.' },
  { naam: 'CNK-codes', voor: 'MMC Thuis matras', tekst: 'Verkrijgbaar via het apotheekkanaal, met een eigen code per maat.' },
];
---
<Base title="Kwaliteit en certificaten" description="Certificaten en normen van Medical Mattress Care: ISO 14001, Fairsales, Centexbel brandtest CRIB 5, Oeko-Tex 100, MRSA-bestendig, medisch hulpmiddel klasse I.">
  <PageHead title="Kwaliteit en certificaten" lede="Ontwikkeld met onderzoeksinstellingen, getest door erkende labo's. Hier vindt u wat we kunnen aantonen." crumbs={[{ label: 'Kwaliteit' }]} />

  <div class="wrap list">
    <ul>
      {items.map((i) => (
        <li>
          <h2>{i.naam}</h2>
          <p class="voor">{i.voor}</p>
          <p>{i.tekst}</p>
          {i.href && <a class="link-arrow" href={i.href}><Icon name="download" />{i.link}</a>}
        </li>
      ))}
    </ul>
    <aside>
      <h2>Technische fiche nodig?</h2>
      <p>Voor een aanbesteding of uw technische dienst sturen we de fiche van elk product op.</p>
      <a class="btn btn--indigo" href="/offerte/?type=fiche">Fiche aanvragen <Icon name="arrow" /></a>
    </aside>
  </div>
  <QuoteBand />
</Base>

<style>
  .list { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: var(--space-xl); padding-block: var(--space-xl); align-items: start; }
  ul { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-l) var(--space-m); }
  li { display: grid; gap: 0.45rem; align-content: start; border-top: 2px solid var(--ink); padding-top: 1rem; }
  li h2 { font-size: var(--step-2); }
  .voor { color: var(--orange-deep); font-weight: 500; font-size: var(--step--1); }
  li p:not(.voor) { color: var(--text); }
  li .link-arrow { justify-self: start; margin-top: 0.4rem; color: var(--indigo); }
  aside { position: sticky; top: calc(var(--header-h) + 2rem); background: var(--white); padding: var(--space-m); display: grid; gap: 1rem; justify-items: start; }
  aside h2 { font-size: var(--step-1); }
  aside p { color: var(--muted); }
  @media (max-width: 960px) { .list { grid-template-columns: 1fr; } aside { position: static; } }
  @media (max-width: 620px) { ul { grid-template-columns: 1fr; } }
</style>
