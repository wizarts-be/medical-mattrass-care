---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ProductCard from '../../components/ProductCard.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import Icon from '../../components/Icon.astro';
import { categorieen, perCategorie, categorieUrl, zichtbaar } from '../../lib/catalogus.mjs';
import { toepassingen } from '../../data/site.mjs';
---
<Base title="Producten" description="Alle producten van Medical Mattress Care: medische matrassen, visco matrassen, positioneringshulpstukken, zitkussens, hoofdkussens, dekbedden, lakens en hoezen voor de zorg.">
  <PageHead title="Het gamma." lede={`${zichtbaar.length} producten voor de zorg. Filter op wat u nodig hebt, of zoek op naam en bestelcode.`} crumbs={[{ label: 'Producten' }]} />

  <div class="tools-wrap" data-tools>
    <div class="tools">
      <label class="search">
        <span class="visually-hidden">Zoek op naam of bestelcode</span>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="M13 13l4.5 4.5" /></svg>
        <input type="search" class="input" placeholder="Zoek: visco, PUP 23, kussen…" data-search autocomplete="off" />
      </label>
      <div class="chips" role="group" aria-label="Filter op toepassing">
        <button type="button" class="chip" aria-pressed="true" data-filter="">Alles</button>
        {toepassingen.map((t) => (<button type="button" class="chip" aria-pressed="false" data-filter={t.slug}>{t.kort}</button>))}
      </div>
    </div>
  </div>

  <div class="catalogue">
    <p class="status" role="status" aria-live="polite" data-status></p>
    {categorieen.map((c) => {
      const items = perCategorie(c.slug);
      if (!items.length) return null;
      return (
        <section class="cat" id={c.slug} data-cat aria-labelledby={`h-${c.slug}`}>
          <header>
            <h2 id={`h-${c.slug}`}><a href={categorieUrl(c)}>{c.naam}</a></h2>
            <p>{c.kort}</p>
          </header>
          <ul class="grid-cards rows">{items.map((p) => <ProductCard p={p} />)}</ul>
        </section>
      );
    })}
    <div class="empty" hidden data-empty>
      <p><strong>Geen product gevonden.</strong> Probeer een andere zoekterm, of vraag het ons: veel maken we op maat.</p>
      <a class="link-arrow" href="/offerte/?type=maatwerk">Maatwerk aanvragen <Icon name="arrow" /></a>
    </div>
  </div>

  <QuoteBand lines={['Niet gevonden?', 'Wij maken het.']} text="MMC levert matrassen en kussens in opbouw en maat naar uw wens. Vraag het ons." href="/offerte/?type=maatwerk" label="Maatwerk aanvragen" />
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-search]');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const rows = [...document.querySelectorAll<HTMLElement>('.rows > li')];
  const cats = [...document.querySelectorAll<HTMLElement>('[data-cat]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  let filter = '';

  const apply = () => {
    const q = (input?.value ?? '').trim().toLowerCase();
    let n = 0;
    rows.forEach((r) => {
      const ok = (!filter || (r.dataset.toepassingen ?? '').split(' ').includes(filter)) && (!q || (r.dataset.zoek ?? '').includes(q));
      r.hidden = !ok;
      if (ok) n++;
    });
    cats.forEach((c) => (c.hidden = !c.querySelector('.rows > li:not([hidden])')));
    if (empty) empty.hidden = n > 0;
    if (status) status.textContent = filter || q ? `${n} ${n === 1 ? 'product' : 'producten'} gevonden` : '';
  };
  chips.forEach((b) => b.addEventListener('click', () => {
    filter = b.dataset.filter ?? '';
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
    apply();
  }));
  input?.addEventListener('input', apply);
</script>

<style>
  .tools-wrap { position: sticky; top: var(--header-h); z-index: 20; background: rgb(255 255 255 / 0.94); border-block: 1px solid var(--sheet-line); }
  @supports (backdrop-filter: blur(1px)) { .tools-wrap { background: rgb(255 255 255 / 0.8); backdrop-filter: blur(14px) saturate(1.3); } }
  .tools { display: grid; grid-template-columns: minmax(14rem, 24rem) 1fr; gap: 0.75rem 1.5rem; align-items: center; padding: 0.85rem var(--gutter); }
  .search { position: relative; }
  .search svg { position: absolute; left: 0.95rem; top: 50%; translate: 0 -50%; width: 1.1rem; color: var(--muted); pointer-events: none; }
  .search .input { padding-left: 2.7rem; min-height: 3rem; background: var(--sheet); border-color: transparent; }
  .search .input:hover { border-color: var(--sheet-line); }
  .search .input:focus { background: var(--white); }
  .chips { display: flex; gap: 0.4rem; overflow-x: auto; scrollbar-width: none; padding-block: 2px; overscroll-behavior-x: contain; }
  .chips::-webkit-scrollbar { display: none; }
  .chip {
    flex: none; min-height: 2.75rem; padding: 0.45rem 1rem; border: 1px solid var(--sheet-line); background: var(--white);
    color: var(--ink); font-size: var(--step--1); font-weight: 500; border-radius: 0;
    transition: background-color 0.25s var(--ease-out), color 0.25s var(--ease-out), border-color 0.25s var(--ease-out);
  }
  @media (hover: hover) { .chip:hover { border-color: var(--ink); } }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--white); border-color: var(--ink); }
  @media (max-width: 760px) { .tools { grid-template-columns: 1fr; } }

  .catalogue { background: var(--sheet); padding: var(--space-m) var(--gutter) var(--space-2xl); }
  .status { min-height: 1.5rem; font-size: var(--step--1); color: var(--muted); }
  .cat { display: grid; gap: var(--space-m); padding-top: var(--space-xl); scroll-margin-top: calc(var(--header-h) + 5.5rem); }
  .cat header { display: grid; gap: 0.8rem; justify-items: start; padding-bottom: var(--space-s); }
  .cat h2 { font-size: clamp(2.2rem, 1rem + 3vw, 4rem); font-weight: 700; letter-spacing: -0.05em; line-height: 0.95; color: var(--ink); }
  .cat h2 a { text-decoration: none; }
  .cat h2 a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--orange); }
  .cat header p { color: var(--muted); font-size: var(--step-1); line-height: 1.45; max-width: 46ch; }
  .cat[hidden], .rows > li[hidden] { display: none; }
  .empty { padding-block: var(--space-l); display: grid; gap: 1rem; justify-items: start; }
  .empty strong { font-family: var(--display); font-stretch: 112%; font-weight: 680; font-size: var(--step-2); letter-spacing: -0.03em; color: var(--ink); display: block; margin-bottom: 0.3rem; }
</style>
