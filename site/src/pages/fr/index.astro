---
import Base from '../../layouts/Base.astro';
import { bedrijf } from '../../data/site.mjs';
---
<Base title="Version française" description="Notre site en français arrive bientôt. Contactez-nous en attendant." noindex>
  <section class="soon" lang="fr">
    <div class="wrap">
      <h1>Version française</h1>
      <p>Notre site en français arrive bientôt. Contactez-nous en attendant.</p>
      <p><a href={`tel:${bedrijf.telefoonHref}`}>+32 473 59 11 71</a> · <a href={`mailto:${bedrijf.email}`}>{bedrijf.email}</a></p>
      <p><a class="btn btn--light" href="/" lang="nl">Retour au site néerlandais</a></p>
    </div>
  </section>
</Base>
<style>
  .soon { background: var(--indigo); color: var(--on-indigo); padding-block: var(--space-2xl); min-height: 60vh; }
  h1 { color: var(--on-indigo); font-size: var(--step-4); }
  p { margin-top: 1.2rem; color: var(--on-indigo-muted); }
  a:not(.btn) { color: var(--on-indigo); }
</style>
