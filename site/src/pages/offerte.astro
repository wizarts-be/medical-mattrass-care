---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ProductImage from '../components/ProductImage.astro';
import Icon from '../components/Icon.astro';
import { bedrijf } from '../data/site.mjs';
import { zichtbaar, categorieen, fotoUrl } from '../lib/catalogus.mjs';

// TODO koppeling formulier: vul ENDPOINT in (bv. Formspree of eigen PHP). Leeg = de aanvraag opent als e-mail naar bedrijf.email (michel@).
const ENDPOINT = '';

// What the request is about. Each choice also sets the wording of the product step below.
const types = [
  { v: 'offerte', l: 'Prijs voor producten', s: 'U kiest de producten en aantallen, wij sturen uw offerte.', vraag: 'Welke producten wilt u?', hint: 'Kies een categorie, tik uw producten aan en geef het aantal door.' },
  { v: 'staal', l: 'Staal', s: 'Probeer een product eerst uit.', vraag: 'Van welke producten wilt u een staal?', hint: 'Kies een categorie en tik uw producten aan.' },
  { v: 'fiche', l: 'Technische fiche', s: 'Maten, samenstelling en normen.', vraag: 'Van welke producten wilt u de fiche?', hint: 'Kies een categorie en tik uw producten aan.' },
  { v: 'maatwerk', l: 'Maatwerk', s: 'Uw eigen maat of opbouw.', vraag: 'Op welk product lijkt uw vraag?', hint: 'Niet verplicht. Uw maten en wensen zet u in het bericht.' },
  { v: 'anders', l: 'Iets anders', s: 'Vertel het ons in uw bericht.', vraag: 'Gaat het over een product?', hint: 'Niet verplicht. Kies het hier, of leg het uit in uw bericht.' },
];
const functies = ['Aankoop', 'Directie', 'Hoofdverpleging', 'Ergotherapie', 'Technische dienst', 'Particulier', 'Andere'];

// Picker data: the label sent with the request, and the sizes or versions of a product.
const basis = (p: any) => (p.code && p.code !== p.naam ? `${p.code} – ${p.naam}` : p.naam);
const uitvoeringen = (p: any) => (p.varianten?.rijen ?? []).map((r: string[]) => (p.varianten.kolommen[1] === 'CNK-code' ? r[0] : `${r[0]} – ${r[1]}`));
const groepen = categorieen
  .map((c) => ({ ...c, items: zichtbaar.filter((p) => p.categorie === c.slug) }))
  .filter((c) => c.items.length);
---
<Base title="Offerte aanvragen" description="Vraag een offerte, een staal of een technische fiche aan bij Medical Mattress Care. Geef de producten en aantallen door, u krijgt snel antwoord.">
  <PageHead title="Vraag" accent="uw prijs." lede="Geef door welke producten en hoeveel. Wij sturen een offerte, een staal of de technische fiche." crumbs={[{ label: 'Offerte' }]} />

  <div class="band band--sheet layout">
    <form class="form" novalidate data-form data-type="offerte" data-endpoint={ENDPOINT} data-mail={bedrijf.email}>
      <fieldset class="field">
        <legend>Wat wilt u aanvragen?</legend>
        <div class="opts">
          {types.map((t, i) => (
            <label class="opt">
              <input type="radio" name="type" value={t.v} checked={i === 0} data-label={t.l} data-vraag={t.vraag} data-hint={t.hint} />
              <span class="opt-box">
                <span class="opt-dot" aria-hidden="true"></span>
                <span class="opt-t">{t.l}</span>
                <span class="opt-s">{t.s}</span>
              </span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="field picker">
        <legend data-vraag>{types[0].vraag}</legend>
        <p class="hint" data-hint>{types[0].hint}</p>

        <div class="search">
          <Icon name="search" />
          <label class="visually-hidden" for="zoek">Zoek op naam of bestelcode</label>
          <input id="zoek" class="input" type="search" placeholder="Zoek op naam of bestelcode" autocomplete="off" enterkeyhint="search" data-search />
        </div>

        <!-- Step 1: the families -->
        <ul class="tiles" data-cats>
          {groepen.map((c) => (
            <li>
              <button type="button" class="tile" data-cat={c.slug} data-naam={c.naam}>
                <span class="tile-img" aria-hidden="true"><img src={fotoUrl(c.beeld)} alt="" width="640" height="427" loading="lazy" decoding="async" /></span>
                <span class="tile-t">{c.naam}</span>
                <span class="tile-s" data-cat-count={`${c.items.length} ${c.items.length === 1 ? 'product' : 'producten'}`}>{c.items.length} {c.items.length === 1 ? 'product' : 'producten'}</span>
              </button>
            </li>
          ))}
        </ul>

        <!-- Step 2: the products of one family, or the search results -->
        <div class="prods" data-prods hidden>
          <div class="prods-head">
            <button type="button" class="back" data-back><Icon name="arrow" />Alle categorieën</button>
            <h3 data-prods-title tabindex="-1"></h3>
          </div>
          <ul class="tiles">
            {zichtbaar.map((p) => (
              <li data-item data-cat={p.categorie} data-zoek={`${p.naam} ${p.code ?? ''} ${(p.varianten?.rijen ?? []).flat().join(' ')}`} hidden>
                <button type="button" class="tile" aria-pressed="false" data-tile data-slug={p.slug} data-code={p.code ?? p.naam} data-naam={p.naam} data-basis={basis(p)} data-uitvoeringen={JSON.stringify(uitvoeringen(p))}>
                  <span class="tile-img" aria-hidden="true" data-photo><ProductImage p={p} size="thumb" alt="" /></span>
                  <span class="tile-check" aria-hidden="true"><Icon name="check" /></span>
                  <span class="tile-t">{p.naam}</span>
                  {p.code && p.code !== p.naam && <span class="tile-s">{p.code}</span>}
                </button>
              </li>
            ))}
          </ul>
          <p class="empty" data-empty hidden>Niets gevonden. Typ uw product hieronder, dan zoeken wij het voor u uit.</p>
        </div>

        <div class="own">
          <label for="eigen">Staat uw product er niet bij?</label>
          <div class="own-row">
            <input id="eigen" class="input" placeholder="Typ de naam of maat" autocomplete="off" enterkeyhint="done" data-own />
            <button type="button" class="btn btn--ghost" data-own-add>Toevoegen</button>
          </div>
        </div>

        <!-- The selection: what is actually sent -->
        <div class="chosen" data-chosen hidden>
          <h3>Uw selectie <span data-chosen-n></span></h3>
          <ol class="picks" data-picks></ol>
        </div>
        <p class="visually-hidden" role="status" data-said></p>

        <template data-pick>
          <li class="pick">
            <span class="pick-img" aria-hidden="true" data-pick-img></span>
            <div class="pick-main">
              <p class="pick-t" data-pick-t></p>
              <div class="vars" role="group" aria-label="Kies de uitvoering" data-vars hidden></div>
              <button type="button" class="more" data-more hidden><Icon name="plus" />Nog een uitvoering</button>
            </div>
            <div class="qty">
              <button type="button" data-step="-1" aria-label="Eén minder"><Icon name="minus" /></button>
              <input name="aantal" type="number" min="1" value="1" inputmode="numeric" aria-label="Aantal" />
              <button type="button" data-step="1" aria-label="Eén meer"><Icon name="plus" /></button>
            </div>
            <button type="button" class="remove" data-remove><Icon name="close" /><span class="visually-hidden" data-remove-label>Verwijder</span></button>
            <input type="hidden" name="product" />
          </li>
        </template>
      </fieldset>

      <div class="cols">
        <div class="field">
          <label for="instelling">Instelling of bedrijf</label>
          <input id="instelling" class="input" name="instelling" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="functie">Uw functie</label>
          <select id="functie" class="input" name="functie">
            <option value="">Kies…</option>
            {functies.map((f) => <option>{f}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="naam">Naam <span class="req">verplicht</span></label>
          <input id="naam" class="input" name="naam" autocomplete="name" required aria-describedby="naam-err" />
          <p class="error-text" id="naam-err" hidden>Vul uw naam in.</p>
        </div>
        <div class="field">
          <label for="email">E-mail <span class="req">verplicht</span></label>
          <input id="email" class="input" name="email" type="email" autocomplete="email" required aria-describedby="email-err" />
          <p class="error-text" id="email-err" hidden>Vul een geldig e-mailadres in, zodat we kunnen antwoorden.</p>
        </div>
        <div class="field">
          <label for="tel">Telefoon</label>
          <input id="tel" class="input" name="telefoon" type="tel" autocomplete="tel" />
        </div>
        <div class="field">
          <label for="gemeente">Leveren in (gemeente)</label>
          <input id="gemeente" class="input" name="gemeente" autocomplete="address-level2" />
        </div>
      </div>

      <div class="field">
        <label for="bericht">Bericht</label>
        <textarea id="bericht" class="input" name="bericht" placeholder="Maten, gebruik, gewenste leverdatum…"></textarea>
      </div>

      <label class="consent">
        <input type="checkbox" name="privacy" required aria-describedby="privacy-err" />
        <span>Ik ga akkoord dat MMC mijn gegevens gebruikt om deze aanvraag te beantwoorden. <a href="/privacybeleid/">Privacybeleid</a></span>
      </label>
      <p class="error-text" id="privacy-err" hidden>Vink dit aan om te kunnen versturen.</p>

      <div class="submit">
        <button class="btn" type="submit" data-submit>Aanvraag versturen <Icon name="arrow" /></button>
        <p class="hint" data-mode>{ENDPOINT ? 'U krijgt een bevestiging per e-mail.' : 'Uw e-mailprogramma opent met uw aanvraag, klaar om te versturen.'}</p>
      </div>
      <div class="done" role="status" aria-live="polite" data-done hidden></div>
    </form>

    <aside class="direct">
      <h2>Liever meteen spreken?</h2>
      <a class="big" href={`tel:${bedrijf.telefoonHref}`}><Icon name="phone" />{bedrijf.telefoon}</a>
      <a href={`mailto:${bedrijf.email}`}><Icon name="mail" />{bedrijf.email}</a>
      <dl>
        {bedrijf.uren.map(([d, u]) => (<><dt>{d}</dt><dd>{u}</dd></>))}
      </dl>
      <hr class="zip" />
      <p>Particulier? De MMC Thuis matras vindt u ook bij uw apotheek, met CNK-code.</p>
    </aside>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const done = form.querySelector<HTMLElement>('[data-done]')!;
  const $ = <T extends HTMLElement>(s: string, root: ParentNode = form) => root.querySelector<T>(s)!;
  const $$ = <T extends HTMLElement>(s: string, root: ParentNode = form) => [...root.querySelectorAll<T>(s)];

  const search = $<HTMLInputElement>('[data-search]');
  const cats = $('[data-cats]');
  const prods = $('[data-prods]');
  const title = $('[data-prods-title]');
  const back = $<HTMLButtonElement>('[data-back]');
  const empty = $('[data-empty]');
  const items = $$<HTMLLIElement>('[data-item]');
  const chosen = $('[data-chosen]');
  const picks = $<HTMLOListElement>('[data-picks]');
  const template = $<HTMLTemplateElement>('[data-pick]');
  const said = $('[data-said]');
  const own = $<HTMLInputElement>('[data-own]');

  /* ── Request type: sets the wording of the product step ── */
  const radios = $$<HTMLInputElement>('input[name="type"]');
  const applyType = () => {
    const r = radios.find((x) => x.checked)!;
    form.dataset.type = r.value;
    $('[data-vraag]:not(input)').textContent = r.dataset.vraag!;
    $('[data-hint]:not(input)').textContent = r.dataset.hint!;
    // A data sheet has no quantity
    $$<HTMLInputElement>('input[name="aantal"]').forEach((i) => { i.disabled = r.value === 'fiche'; });
  };
  radios.forEach((r) => r.addEventListener('change', applyType));

  /* ── Browse: families, then products; search looks across everything ── */
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  let cat = '';
  const view = () => {
    const q = norm(search.value.trim());
    cats.hidden = !!(q || cat);
    prods.hidden = !(q || cat);
    if (prods.hidden) return;
    const words = q.split(/\s+/).filter(Boolean);
    let n = 0;
    items.forEach((li) => {
      const hay = norm(li.dataset.zoek!);
      const show = q ? words.every((w) => hay.includes(w)) : li.dataset.cat === cat;
      li.hidden = !show;
      if (show) n++;
    });
    empty.hidden = n > 0;
    back.hidden = !!q;
    title.textContent = q ? `${n} ${n === 1 ? 'resultaat' : 'resultaten'}` : $(`[data-cat="${cat}"].tile`).dataset.naam!;
  };
  cats.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('.tile');
    if (!b) return;
    cat = b.dataset.cat!;
    view();
    title.focus({ preventScroll: true });
    prods.scrollIntoView({ block: 'nearest' });
  });
  back.addEventListener('click', () => {
    const was = cat; cat = ''; view();
    $(`[data-cat="${was}"].tile`).focus();
  });
  search.addEventListener('input', view);
  search.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') e.preventDefault();
    if (e.key === 'Escape' && search.value) { search.value = ''; view(); }
  });

  /* ── Selection ── */
  const sync = () => {
    const rows = $$<HTMLLIElement>('.pick', picks);
    chosen.hidden = !rows.length;
    $('[data-chosen-n]').textContent = rows.length ? `(${rows.length})` : '';
    const slugs = rows.map((r) => r.dataset.slug);
    $$<HTMLButtonElement>('[data-tile]').forEach((t) => t.setAttribute('aria-pressed', String(slugs.includes(t.dataset.slug))));
    // Show on each family how many of its products are already chosen
    $$<HTMLElement>('[data-cat-count]').forEach((s) => {
      const c = s.closest<HTMLElement>('.tile')!.dataset.cat;
      const k = rows.filter((r) => r.dataset.cat === c).length;
      s.textContent = k ? `${k} gekozen` : s.dataset.catCount!;
      s.classList.toggle('on', k > 0);
    });
  };

  const addRow = (o: { slug?: string; cat?: string; naam: string; basis: string; opties?: string[]; photo?: HTMLElement | null }) => {
    const li = (template.content.firstElementChild as HTMLLIElement).cloneNode(true) as HTMLLIElement;
    li.dataset.slug = o.slug ?? '';
    li.dataset.cat = o.cat ?? '';
    $('[data-pick-t]', li).textContent = o.naam;
    if (o.photo) $('[data-pick-img]', li).append(o.photo.firstElementChild!.cloneNode(true));
    const hidden = $<HTMLInputElement>('input[name="product"]', li);
    hidden.value = o.basis;
    $<HTMLInputElement>('input[name="aantal"]', li).disabled = form.dataset.type === 'fiche';
    $<HTMLInputElement>('input[name="aantal"]', li).setAttribute('aria-label', `Aantal van ${o.naam}`);
    $('[data-remove-label]', li).textContent = `Verwijder ${o.naam}`;

    const opties = o.opties ?? [];
    if (opties.length) {
      const vars = $('[data-vars]', li);
      vars.hidden = false;
      vars.setAttribute('aria-label', `Uitvoering van ${o.naam}`);
      opties.forEach((label) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'var'; b.textContent = label;
        b.setAttribute('aria-pressed', 'false');
        b.addEventListener('click', () => {
          const on = b.getAttribute('aria-pressed') !== 'true';
          $$<HTMLButtonElement>('.var', vars).forEach((x) => x.setAttribute('aria-pressed', 'false'));
          b.setAttribute('aria-pressed', String(on));
          hidden.value = !on ? o.basis : label.startsWith('MMC') ? label : `${o.naam} – ${label}`;
        });
        vars.append(b);
      });
      if (opties.length > 1) {
        const more = $<HTMLButtonElement>('[data-more]', li);
        more.hidden = false;
        more.addEventListener('click', () => {
          const next = addRow(o);
          li.after(next);
          sync();
          $<HTMLButtonElement>('.var', next).focus();
        });
      }
    }
    return li;
  };

  const pick = (t: HTMLElement) => {
    const naam = t.dataset.naam!;
    const rows = $$<HTMLLIElement>('.pick', picks).filter((r) => r.dataset.slug === t.dataset.slug);
    if (rows.length) { rows.forEach((r) => r.remove()); said.textContent = `${naam} verwijderd`; }
    else {
      picks.append(addRow({
        slug: t.dataset.slug, cat: t.closest<HTMLElement>('[data-item]')!.dataset.cat, naam, basis: t.dataset.basis!,
        opties: JSON.parse(t.dataset.uitvoeringen || '[]'), photo: $('[data-photo]', t),
      }));
      said.textContent = `${naam} toegevoegd`;
    }
    sync();
  };
  prods.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-tile]');
    if (t) pick(t);
  });

  picks.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;
    const step = el.closest<HTMLElement>('[data-step]');
    if (step) {
      const i = $<HTMLInputElement>('input[name="aantal"]', step.closest('.qty')!);
      i.value = String(Math.max(1, (parseInt(i.value, 10) || 1) + Number(step.dataset.step)));
      return;
    }
    const rm = el.closest('[data-remove]');
    if (rm) {
      const li = rm.closest('li')!;
      const next = (li.nextElementSibling ?? li.previousElementSibling) as HTMLElement | null;
      said.textContent = `${$('[data-pick-t]', li).textContent} verwijderd`;
      li.remove();
      sync();
      (next ? $<HTMLElement>('[data-remove]', next) : search).focus();
    }
  });
  picks.addEventListener('change', (e) => {
    const i = e.target as HTMLInputElement;
    if (i.name === 'aantal') i.value = String(Math.max(1, parseInt(i.value, 10) || 1));
  });

  // Anything not in the range can still be requested
  const addOwn = () => {
    const v = own.value.trim();
    if (!v) { own.focus(); return; }
    picks.append(addRow({ naam: v, basis: v }));
    own.value = '';
    said.textContent = `${v} toegevoegd`;
    sync();
    own.focus();
  };
  $('[data-own-add]').addEventListener('click', addOwn);
  own.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); addOwn(); } });

  /* ── Prefill from ?type= and ?product= ── */
  const qs = new URLSearchParams(location.search);
  const t = qs.get('type');
  if (t) radios.find((r) => r.value === t)?.click();
  applyType();
  const pre = qs.get('product');
  if (pre) {
    const tile = $$<HTMLElement>('[data-tile]').find((x) => x.dataset.code === pre || x.dataset.naam === pre);
    if (tile) { cat = tile.closest<HTMLElement>('[data-item]')!.dataset.cat!; pick(tile); }
    else picks.append(addRow({ naam: pre, basis: pre }));
    sync();
  }
  view();

  /* ── Send ── */
  const check = (el: HTMLInputElement, ok: boolean) => {
    el.setAttribute('aria-invalid', String(!ok));
    const err = document.getElementById(el.getAttribute('aria-describedby') ?? '');
    if (err) err.hidden = ok;
    return ok;
  };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const naam = form.elements.namedItem('naam') as HTMLInputElement;
    const email = form.elements.namedItem('email') as HTMLInputElement;
    const privacy = form.elements.namedItem('privacy') as HTMLInputElement;
    const ok = [check(naam, !!naam.value.trim()), check(email, email.validity.valid && !!email.value), check(privacy, privacy.checked)];
    if (ok.includes(false)) { form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus(); return; }

    const fd = new FormData(form);
    const soort = radios.find((r) => r.checked)!.dataset.label!;
    const prods = fd.getAll('product').map((p, i) => [p, fd.getAll('aantal')[i]]).filter(([p]) => String(p).trim());
    const endpoint = form.dataset.endpoint;
    if (endpoint) {
      const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
      btn.disabled = true; btn.textContent = 'Bezig met versturen…';
      try {
        const r = await fetch(endpoint, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        if (!r.ok) throw new Error(String(r.status));
        form.querySelectorAll('fieldset, .cols, .field, .consent, .submit').forEach((el) => ((el as HTMLElement).hidden = true));
        done.hidden = false;
        done.innerHTML = '<strong>Bedankt, uw aanvraag is verstuurd.</strong><p>We antwoorden zo snel mogelijk.</p>';
      } catch {
        btn.disabled = false; btn.textContent = 'Opnieuw proberen';
        done.hidden = false;
        done.innerHTML = `<p class="error-text">Versturen lukte niet. Probeer opnieuw, of mail ons op <a href="mailto:${form.dataset.mail}">${form.dataset.mail}</a>.</p>`;
      }
      return;
    }
    const body = [
      `Aanvraag: ${soort}`, '',
      ...(prods.length ? ['Producten:', ...prods.map(([p, a]) => `- ${p}${a ? ` × ${a}` : ''}`), ''] : []),
      `Instelling: ${fd.get('instelling') || '-'}`, `Functie: ${fd.get('functie') || '-'}`,
      `Naam: ${fd.get('naam')}`, `E-mail: ${fd.get('email')}`, `Telefoon: ${fd.get('telefoon') || '-'}`, `Leveren in: ${fd.get('gemeente') || '-'}`, '',
      String(fd.get('bericht') || ''),
    ].join('\n');
    const subject = `Aanvraag ${soort.toLowerCase()} via de website${fd.get('instelling') ? ` – ${fd.get('instelling')}` : ''}`;
    location.href = `mailto:${form.dataset.mail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    done.hidden = false;
    done.innerHTML = '<strong>Uw e-mail staat klaar.</strong><p>Opende er niets? Mail uw aanvraag naar <a href="mailto:' + form.dataset.mail + '">' + form.dataset.mail + '</a>.</p>';
  });
</script>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem); gap: var(--space-l) var(--space-xl); align-items: start; padding-top: var(--space-l); }
  .form { display: grid; gap: var(--space-l); background: var(--white); padding: clamp(1.25rem, 1rem + 2.5vw, 3rem); max-width: 56rem; min-width: 0; }
  .form legend, .form > .field > label { font-family: var(--display); font-stretch: 112%; font-weight: 680; font-size: var(--step-1); letter-spacing: -0.02em; color: var(--ink); }
  fieldset { border: 0; padding: 0; min-width: 0; }
  legend { margin-bottom: 0.5rem; padding: 0; }

  /* ── Request type: the main request wide, the other four beneath it ── */
  .opts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; margin-top: 0.4rem; }
  .opt { position: relative; display: grid; cursor: pointer; }
  .opt:first-child { grid-column: 1 / -1; }
