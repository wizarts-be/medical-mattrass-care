---
// Inner-page head in the home's voice: huge bold left-aligned title (bottom-left),
// short text and actions in a second column (bottom-right).
// tone: light (white), indigo (PU field), image (full-bleed photo like the home hero).
interface Crumb { href?: string; label: string }
interface Props {
  title: string;
  accent?: string;          // second title line, in orange
  lede?: string;
  crumbs?: Crumb[];
  tone?: 'light' | 'indigo' | 'night' | 'image';
  image?: { src: string; mobile?: string; alt?: string; position?: string };
  wide?: boolean;
}
const { title, accent, lede, crumbs = [], tone: _t = 'light', image, wide = false } = Astro.props;
const tone = _t === 'night' ? 'indigo' : _t === 'image' && !image ? 'indigo' : _t;
const trail = [{ href: '/', label: 'Home' }, ...crumbs];
const dark = tone !== 'light';
---
<section class:list={['page-head', `tone-${tone}`, { dark }]}>
  {tone === 'image' && image && (
    <picture class="bg">
      {image.mobile && <source media="(max-width: 900px)" srcset={image.mobile} />}
      <img src={image.src} alt={image.alt ?? ''} width="2560" height="1440" fetchpriority="high" style={image.position ? `object-position:${image.position}` : undefined} />
    </picture>
  )}
  <div class="inner">
    {crumbs.length > 0 && (
      <nav aria-label="Kruimelpad" class="crumbs">
        <ol>
          {trail.map((c, i) => (
            <li>{c.href && i < trail.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    <div class:list={['grid', { wide }]}>
      <div class="titles">
        <slot name="above" />
        <h1>
          <span class="rise"><span>{title}</span></span>
          {accent && <span class="rise" style="--i:1"><em>{accent}</em></span>}
        </h1>
        {lede && <p class="lede rise-after">{lede}</p>}
        <slot name="below" />
      </div>
      <div class="aside rise-after"><slot /></div>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: c.href ? new URL(c.href, 'https://www.medical-mattress-care.com').href : undefined })),
})} />

<style>
  .page-head { position: relative; overflow: hidden; display: grid; }
  .tone-light { background: var(--white); color: var(--ink); }
  .tone-indigo { background: var(--indigo); color: var(--on-indigo); }
  .tone-image { background: var(--night); color: var(--white); min-height: max(32rem, 78svh); }

  .bg { position: absolute; inset: 0; }
  .bg img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 40%; }
  @media (prefers-reduced-motion: no-preference) { .bg img { animation: settle 2.6s var(--ease-out) both; } }
  @keyframes settle { from { transform: scale(1.14); } to { transform: scale(1.03); } }
  .tone-image::before {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg, rgb(21 14 61 / 0.85) 0%, rgb(21 14 61 / 0.5) 45%, rgb(21 14 61 / 0) 78%),
                linear-gradient(0deg, rgb(21 14 61 / 0.72) 0%, rgb(21 14 61 / 0) 50%);
  }

  .inner { position: relative; z-index: 2; display: grid; grid-template-rows: auto 1fr; padding: var(--space-m) var(--gutter) var(--space-xl); }
  .tone-image .inner { padding-bottom: clamp(3rem, 9vh, 6rem); }

  .crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 0.6rem; font-size: var(--step--1); color: var(--muted); }
  .crumbs li + li::before { content: '/'; margin-right: 0.6rem; opacity: 0.5; }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--orange); }
  .crumbs [aria-current] { color: var(--ink); }
  .dark .crumbs ol { color: var(--on-indigo-muted); }
  .dark .crumbs a:hover, .dark .crumbs [aria-current] { color: var(--white); }

  .grid { align-self: end; margin-top: clamp(3rem, 2rem + 5vw, 7rem); display: grid; justify-items: start; }
  .tone-image .grid { margin-top: var(--space-2xl); }

  h1 { font-size: clamp(3rem, 1rem + 6.6vw, 8rem); font-stretch: 112%; font-weight: 700; letter-spacing: -0.05em; line-height: 0.9; color: var(--ink); hyphens: manual; overflow-wrap: break-word; }
  .dark h1 { color: var(--white); }
  h1 em { font-style: normal; color: var(--orange); }
  .lede { margin-top: 2rem; max-width: 40ch; color: var(--muted); font-size: var(--step-1); line-height: 1.5; }
  .dark .lede { color: var(--on-indigo-muted); }
  .aside { display: grid; gap: 1.25rem; justify-items: start; margin-top: var(--space-m); }
  .aside:empty { display: none; }
  .dark .aside :global(.btn--ghost) { --fg: var(--white); --bd: rgb(255 255 255 / 0.5); }
  @media (max-width: 900px) {
    .grid { margin-top: var(--space-xl); }
  }
</style>
