---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import ProductCard from '../../../components/ProductCard.astro';
import QuoteBand from '../../../components/QuoteBand.astro';
import Icon from '../../../components/Icon.astro';
import { categorieen, perCategorie, categorieUrl } from '../../../lib/catalogus.mjs';

export function getStaticPaths() {
  return categorieen.filter((c) => perCategorie(c.slug).length).map((c) => ({ params: { categorie: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const items = perCategorie(c.slug);
const andere = categorieen.filter((x) => x.slug !== c.slug && perCategorie(x.slug).length);
const maatwerk = items.some((p) => p.maatwerk);
---
<Base title={c.lang ?? c.naam} description={`${c.lang ?? c.naam} van Medical Mattress Care. ${c.intro}`}>
  <PageHead title={c.lang ?? c.naam} lede={c.intro} crumbs={[{ href: '/producten/', label: 'Producten' }, { label: c.naam }]}>
    <dl class="facts">
      <div><dt>Producten</dt><dd>{items.length}</dd></div>
      {maatwerk && <div><dt>Maatwerk</dt><dd>mogelijk</dd></div>}
    </dl>
    <a class="btn" href="/offerte/">Offerte aanvragen <Icon name="arrow" /></a>
  </PageHead>

  <section class="band band--sheet" aria-label={`Alle ${c.naam.toLowerCase()}`}>
    <ul class="grid-cards">{items.map((p) => <ProductCard p={p} headingLevel="h2" />)}</ul>
  </section>

  <nav class="band band--white others" aria-labelledby="andere">
    <h2 id="andere" class="title-xl">Ook in het gamma.</h2>
    <ul>
      {andere.map((x) => (<li><a href={categorieUrl(x)}><span>{x.naam}</span><span class="n">{perCategorie(x.slug).length}</span><Icon name="arrow" /></a></li>))}
    </ul>
  </nav>

  <QuoteBand />
</Base>

<style>
  .facts { display: grid; grid-auto-flow: column; grid-auto-columns: max-content; gap: 2rem; }
  .facts div { border-top: 2px solid var(--orange); padding-top: 0.6rem; }
  .facts dt { font-size: var(--step--1); color: var(--muted); }
  .facts dd { margin: 0; font-family: var(--display); font-stretch: 112%; font-weight: 680; font-size: var(--step-2); letter-spacing: -0.03em; color: var(--ink); }
  .others { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--space-l) var(--space-xl); align-items: start; }
  .others ul { list-style: none; padding: 0; display: grid; }
  .others a { display: grid; grid-template-columns: 1fr auto 1.2rem; gap: 1rem; align-items: center; padding: 1rem 0; border-top: 1px solid var(--sheet-line); text-decoration: none; color: var(--ink); font-family: var(--display); font-stretch: 112%; font-weight: 650; font-size: var(--step-1); letter-spacing: -0.02em; transition: color 0.25s var(--ease-out); }
  .others a > span:first-child { transition: transform 0.4s var(--ease-out); }
  .others li:last-child a { border-bottom: 1px solid var(--sheet-line); }
  .others .n { font-family: var(--text-face); font-weight: 400; font-size: var(--step--1); color: var(--muted); font-variant-numeric: tabular-nums; letter-spacing: 0; }
  .others a :global(svg) { width: 1.1rem; color: var(--ink); transition: transform 0.35s var(--ease-out), color 0.25s; }
  @media (hover: hover) { .others a:hover > span:first-child { transform: translateX(0.6rem); } .others a:hover :global(svg) { transform: translateX(4px); color: var(--orange-deep); } }
  @media (max-width: 900px) { .others { grid-template-columns: 1fr; } }
</style>
