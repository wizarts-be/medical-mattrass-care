---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Icon from '../components/Icon.astro';

const items = [
  { naam: 'ISO 14001', voor: 'Productiehuis', tekst: 'Milieumanagement. Het productiehuis draait op eigen groene stroom en beperkt afval tot een minimum.' },
  { naam: 'Fairsales', voor: 'Medical Mattress Care', tekst: 'Gecertificeerd sinds 10.01.2016: eerlijke handel, prijzen zonder verrassingen, dienst na verkoop en een dubbele klachtengarantie.', href: '/docs/fairsales-certificaat-2026.pdf', link: 'Certificaat 2026 (pdf)' },
  { naam: 'Centexbel 58974/B', voor: 'MMC 210 PU-hoes', tekst: 'Brandtest volgens BS 7175, resultaat Crib 5.' },
  { naam: 'Oeko-Tex standaard 100', voor: 'MMC 210 PU-hoes', tekst: 'Getest op schadelijke stoffen.' },
  { naam: 'ATCC #6538 en ASTM G 21-96', voor: 'MMC 210 PU-hoes', tekst: 'Resistent tegen Staphylococcus aureus en schimmels. MRSA-bestendig.' },
  { naam: 'Medisch hulpmiddel klasse I', voor: 'MMC V10', tekst: 'Volgens verordening (EU) 2017/745, norm EN 12182.', href: '/docs/mmc-v10-eu-conformiteitsverklaring.pdf', link: 'EU-conformiteitsverklaring (pdf)' },
  { naam: 'EN ISO 12952:2010', voor: 'MMC Bicolor', tekst: 'Brandveilig volgens de sigarettentest.' },
  { naam: 'CNK-codes', voor: 'MMC Thuis matras', tekst: 'Verkrijgbaar via het apotheekkanaal, met een eigen code per maat.' },
];
---
<Base title="Kwaliteit en certificaten" description="Certificaten en normen van Medical Mattress Care: ISO 14001, Fairsales, Centexbel brandtest CRIB 5, Oeko-Tex 100, MRSA-bestendig, medisch hulpmiddel klasse I.">
  <PageHead title="Getest en" accent="gecertificeerd." lede="Ontwikkeld met onderzoeksinstellingen, getest door erkende labo's. Hier vindt u wat we kunnen aantonen." crumbs={[{ label: 'Kwaliteit' }]} tone="indigo">
    <a class="btn btn--light" href="/offerte/?type=fiche">Technische fiche aanvragen <Icon name="arrow" /></a>
  </PageHead>

  <section class="band band--tall band--white" aria-label="Certificaten en normen">
    <ul class="marks">
      {items.map((i) => (
        <li>
          <h2>{i.naam}</h2>
          <p class="voor">{i.voor}</p>
          <p>{i.tekst}</p>
          {i.href && <a class="link-arrow" href={i.href}><Icon name="download" />{i.link}</a>}
        </li>
      ))}
    </ul>
  </section>

  <QuoteBand />
</Base>

<style>
  .marks { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-xl) var(--space-l); }
  .marks li { display: grid; gap: 0.6rem; align-content: start; border-top: 2px solid var(--orange); padding-top: 1.1rem; }
  .marks h2 { font-size: var(--step-3); font-weight: 700; letter-spacing: -0.045em; line-height: 1; overflow-wrap: break-word; }
  .voor { color: var(--orange-deep); font-weight: 500; font-size: var(--step--1); margin-top: -0.2rem; }
  .marks p:not(.voor) { color: var(--text); max-width: 40ch; }
  .marks .link-arrow { justify-self: start; margin-top: 0.4rem; color: var(--ink); white-space: normal; }
  .marks .link-arrow :global(svg) { color: var(--orange-deep); }
  @media (max-width: 1000px) { .marks { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .marks { grid-template-columns: 1fr; } }

</style>
