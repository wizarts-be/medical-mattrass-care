---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer)." noindex>
  <PageHead title="Deze pagina" accent="is opgeruimd." lede="Misschien verhuisde ze met onze nieuwe website. Zoek verder in het gamma, of vraag het ons." tone="image" image={{ src: '/img/beeld/hero-2560.webp', mobile: '/img/beeld/hero-1280.webp' }}>
    <div class="cta">
      <a class="btn btn--light" href="/producten/">Naar de producten <Icon name="arrow" /></a>
      <a class="btn btn--ghost-light" href="/">Naar de startpagina</a>
    </div>
  </PageHead>
</Base>
<style>.cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }</style>
