---
// The orange close, same as the home page: huge two-line title left, text and actions right.
import Icon from './Icon.astro';
import { bedrijf } from '../data/site.mjs';
interface Props { lines?: string[]; text?: string; href?: string; label?: string; staal?: boolean }
const {
  lines = ['Vraag', 'uw prijs.'],
  text = 'Zeg welke producten en hoeveel. U krijgt snel een offerte, of eerst een staal.',
  href = '/offerte/',
  label = 'Offerte aanvragen',
  staal = true,
} = Astro.props;
---
<section class="qband" aria-label={lines.join(' ')} data-qband>
  <h2>{lines.map((l, i) => (<span class="ln" style={`--i:${i}`}><span>{l}</span></span>))}</h2>
  <div class="side">
    <p>{text}</p>
    <div class="cta">
      <a class="btn btn--blue" href={href}>{label} <Icon name="arrow" /></a>
      {staal && <a class="btn btn--ghost" href="/offerte/?type=staal">Staal aanvragen</a>}
    </div>
    <p class="contact"><a href={`tel:${bedrijf.telefoonHref}`}>{bedrijf.telefoon}</a><a href={`mailto:${bedrijf.email}`}>{bedrijf.email}</a></p>
  </div>
</section>

<script>
  // lines rise out of their mask once the band scrolls into view
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -20% 0px' });
  document.querySelectorAll('[data-qband]').forEach((el) => { el.classList.add('will-rise'); io.observe(el); });
</script>

<style>
  .qband { background: var(--orange); color: var(--ink); padding: var(--space-2xl) var(--gutter); display: grid; gap: var(--space-m); justify-items: start; }
  h2 { font-size: clamp(3.2rem, 1rem + 7vw, 8.5rem); font-stretch: 112%; font-weight: 700; letter-spacing: -0.055em; line-height: 0.88; color: var(--ink); }
  .ln { display: block; overflow: hidden; padding-bottom: 0.07em; margin-bottom: -0.07em; }
  .ln > span { display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .will-rise .ln > span { transform: translateY(110%); transition: transform 1.1s var(--ease-out); transition-delay: calc(var(--i) * 0.1s); }
    .will-rise.is-in .ln > span { transform: none; }
  }
  .side { display: grid; gap: 1.4rem; justify-items: start; }
  .side > p:first-child { font-size: var(--step-1); line-height: 1.5; max-width: 32ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .qband .btn--ghost { --fg: var(--ink); --bd: var(--ink); }
  .contact { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; }
  .contact a { font-weight: 500; text-decoration-color: rgb(38 26 102 / 0.4); font-variant-numeric: tabular-nums; }
  .contact a:hover { text-decoration-color: var(--ink); }
  .qband ::selection { background: var(--ink); color: var(--orange); }
</style>
