---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import ProductCard from '../../../components/ProductCard.astro';
import QuoteBand from '../../../components/QuoteBand.astro';
import Icon from '../../../components/Icon.astro';
import MeerTekst from '../../../components/MeerTekst.astro';
import { categorieTekst } from '../../../lib/teksten';
import { categorieen, perCategorie, categorieUrl } from '../../../lib/catalogus.mjs';

export function getStaticPaths() {
  return categorieen.filter((c) => perCategorie(c.slug).length).map((c) => ({ params: { categorie: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const items = perCategorie(c.slug);
const andere = categorieen.filter((x) => x.slug !== c.slug && perCategorie(x.slug).length);
const maatwerk = items.some((p) => p.maatwerk);
const tekst = categorieTekst(c.slug);
// Key facts beside the title: how many, which cover, made to measure or standard.
const kort = { '210': '210 PU', '120': '120 PU', velours: 'velours', dubbeldoek: 'dubbeldoek' } as Record<string, string>;
const hoezen = [...new Set(items.map((p) => p.hoes).filter(Boolean))].map((h) => kort[h] ?? h);
const feiten = [
  ['Gamma', String(items.length), items.length === 1 ? 'product' : 'producten'],
  hoezen.length === 1 ? ['Hoes', hoezen[0], hoezen[0] === '210 PU' ? 'wasbaar op 95 °C' : ''] : hoezen.length ? ['Hoezen', String(hoezen.length), hoezen.join(', ')] : null,
  maatwerk ? ['Maatwerk', 'Mogelijk', 'andere maat of opbouw'] : ['Levering', 'Uit stock', 'standaardmaten'],
].filter(Boolean) as string[][];
// Grid that always fills its rows: up to 4 products in one row; more in rows of 3 or 4,
// with the first product widened so the last row is never half empty.
const n = items.length;
const cols = n <= 4 ? n : n % 3 === 0 ? 3 : 4;
const rest = (n - 1) % cols;
const leadSpan = n <= 4 ? 1 : cols - rest; // rest 0 → the lead takes a full row
---
<Base title={c.lang ?? c.naam} description={`${c.lang ?? c.naam} van Medical Mattress Care. ${c.intro}`}>
  <PageHead title={c.lang ?? c.naam} lede={c.intro} crumbs={[{ href: '/producten/', label: 'Producten' }, { label: c.naam }]} compact split>
    <dl class="facts">
      {feiten.map(([k, v, s]) => (<div><dt>{k}</dt><dd><strong>{v}</strong>{s && <span>{s}</span>}</dd></div>))}
    </dl>
    <a class="btn" href="/offerte/">Offerte aanvragen <Icon name="arrow" /></a>
  </PageHead>

  <section class="band band--sheet list" aria-label={`Alle ${c.naam.toLowerCase()}`}>
    <ul class="cards" style={`--cols:${cols}`}>
      {items.map((p, i) => (
        <ProductCard
          p={p}
          headingLevel="h2"
          variant={n <= 2 || (i === 0 && leadSpan > 1) ? 'feature' : 'card'}
          style={`--i:${i};${i === 0 && leadSpan > 1 ? `grid-column: span ${leadSpan}` : ''}`}
        />
      ))}
    </ul>
  </section>

  {tekst && <MeerTekst titel={tekst.titel} intro={tekst.intro} blokken={tekst.blokken} />}

  <nav class:list={['band', tekst ? 'band--sheet' : 'band--white', 'others']} aria-labelledby="andere">
    <h2 id="andere" class="title-xl">Ook in het gamma.</h2>
    <ul>
      {andere.map((x) => { const k = perCategorie(x.slug).length; return (
        <li><a href={categorieUrl(x)}><span class="nm">{x.naam.replace(/(?<=\p{L}{6})(kussens)/u, '\u00AD$1')}</span><span class="n">{k} {k === 1 ? 'product' : 'producten'} <Icon name="arrow" /></span></a></li>
      ); })}
    </ul>
  </nav>

  <QuoteBand />
</Base>

<style>
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-m); width: 100%; min-width: 0; margin: 0; }
  .facts > div { min-width: 0; display: grid; gap: 0.5rem; align-content: start; padding-top: 1rem; border-top: 2px solid var(--orange); }
  .facts dt { font-size: var(--step--1); color: var(--muted); }
  .facts dd { margin: 0; display: grid; gap: 0.2rem; }
  .facts strong { font-family: var(--display); font-stretch: 112%; font-weight: 700; font-size: var(--step-2); letter-spacing: -0.035em; line-height: 1.05; color: var(--ink); overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
  .facts span { font-size: var(--step--1); color: var(--muted); }
  @media (max-width: 480px) { .facts { gap: var(--space-s, 0.9rem); } .facts strong { font-size: var(--step-1); } }

  .list { padding-top: var(--space-m); }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  @media (prefers-reduced-motion: no-preference) {
    .cards > :global(li) { animation: card-in 0.8s var(--ease-out) both; animation-delay: calc(0.15s + var(--i, 0) * 0.06s); }
  }
  @keyframes card-in { from { opacity: 0; transform: translateY(1.5rem); } }
  @media (max-width: 1100px) { .cards { grid-template-columns: repeat(min(var(--cols), 3), minmax(0, 1fr)); } }
  @media (max-width: 900px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } .cards > :global(li) { grid-column: auto !important; } .cards > :global(.v-feature) { grid-column: 1 / -1 !important; } }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } }

  .others h2 { margin-bottom: var(--space-l); }
  .others ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 var(--space-m); }
  .others a { display: grid; gap: 0.6rem; align-content: space-between; min-height: 7.5rem; padding: 1.1rem 0 1.4rem; border-top: 1px solid var(--sheet-line); text-decoration: none; color: var(--ink); transition: border-color 0.3s var(--ease-out); }
  .others .nm { font-family: var(--display); font-stretch: 112%; font-weight: 650; font-size: var(--step-1); letter-spacing: -0.02em; line-height: 1.15; overflow-wrap: break-word; hyphens: manual; }
  .others .n { display: inline-flex; align-items: center; gap: 0.5rem; font-size: var(--step--1); color: var(--muted); font-variant-numeric: tabular-nums; }
  .others a :global(svg) { width: 1rem; color: var(--ink); transition: transform 0.35s var(--ease-out), color 0.25s; }
  @media (hover: hover) { .others a:hover { border-color: var(--orange); } .others a:hover :global(svg) { transform: translateX(4px); color: var(--orange-deep); } }
  @media (max-width: 1000px) { .others ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .others ul { grid-template-columns: 1fr; } .others a { min-height: 0; } }
</style>
