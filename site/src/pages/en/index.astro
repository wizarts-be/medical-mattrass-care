---
import Base from '../../layouts/Base.astro';
import { bedrijf } from '../../data/site.mjs';
---
<Base title="English version" description="Our English website is coming soon. In the meantime, feel free to contact us." noindex>
  <section class="soon" lang="en">
    <div class="wrap">
      <h1>English version</h1>
      <p>Our English website is coming soon. In the meantime, feel free to contact us.</p>
      <p><a href={`tel:${bedrijf.telefoonHref}`}>+32 473 59 11 71</a> · <a href={`mailto:${bedrijf.email}`}>{bedrijf.email}</a></p>
      <p><a class="btn" href="/" lang="nl">Back to the Dutch site</a></p>
    </div>
  </section>
</Base>
<style>
  .soon { background: var(--indigo); color: var(--on-indigo); padding-block: var(--space-2xl); min-height: 60vh; }
  h1 { color: var(--on-indigo); font-size: var(--step-4); }
  p { margin-top: 1.2rem; color: var(--on-indigo-muted); }
  a:not(.btn) { color: var(--on-indigo); }
</style>
