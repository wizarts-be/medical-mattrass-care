---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Icon from '../components/Icon.astro';
import { hoesFiche, ontsmetting } from '../data/site.mjs';
import { offerteUrl } from '../lib/catalogus.mjs';

const eigenschappen = [
  'Bi-elastisch weefsel: volgt de matras zonder plooien',
  'Ondoordringbaar voor water en urine, en toch ademend',
  'Geen naden in de ligvlakken',
  'Verborgen rits in dezelfde kleur, met L-sluiting: makkelijk af te ritsen',
  'Bacterie- en schimmelresistent, MRSA-bestendig',
  'Volledig wasbaar met de ontsmettingsproducten uit de zorgsector',
];
const onderhoud = [
  { sym: '95', label: 'Wasbaar op 95 °C' },
  { sym: 'bleach', label: 'Niet bleken' },
  { sym: 'iron', label: 'Niet strijken' },
  { sym: 'A', label: 'Enkel reinigen met producten met klasse A-label' },
  { sym: 'dry', label: 'Droogkast tot niveau 1' },
];
---
<Base title="MMC 210 PU-hoes" description="De MMC 210 PU-hoes: MRSA-bestendig, wasbaar op 95 °C, steriliseerbaar tot 115 °C, brandnorm CRIB 5, Oeko-Tex standaard 100. Technische fiche en onderhoud.">
  <PageHead
    title="De hoes die"
    accent="alles aankan."
    lede="De MMC 210 PU-hoes: polyurethaan op een bi-elastisch weefsel. Standaard op onze matrassen en de meeste hulpstukken, en los te bestellen op maat."
    crumbs={[{ label: 'De hoes' }]}
    tone="image"
    image={{ src: '/img/beeld/hero-2560.webp', mobile: '/img/beeld/hero-1280.webp', alt: '' }}
  >
    <div class="head-cta">
      <a class="btn btn--light" href={offerteUrl({ code: 'MMC 210 PU-hoes' })}>Hoezen op maat aanvragen <Icon name="arrow" /></a>
      <a class="btn btn--ghost-light" href={offerteUrl({ code: 'MMC 210 PU-hoes' }, 'staal')}>Staal van de stof</a>
    </div>
  </PageHead>

  <section class="band band--indigo" aria-labelledby="cijfers">
    <div class="split-head">
      <h2 id="cijfers" class="title-xl">Ondoordringbaar,<br />en toch ademend.</h2>
      <p>Water en urine blijven buiten, de matras blijft droog. MRSA-bestendig en volledig wasbaar met de ontsmettingsproducten uit de zorg.</p>
    </div>
    <dl class="facts">
      <div><dt>95<span class="u"> °C</span></dt><dd>wasbaar, krimp max. 5 %</dd></div>
      <div><dt>115<span class="u"> °C</span></dt><dd>steriliseerbaar</dd></div>
      <div><dt><span class="u">CRIB </span>5</dt><dd>brandnorm, Centexbel 58974/B</dd></div>
      <div><dt><span class="u">&gt; </span>200<span class="u"> cm</span></dt><dd>waterkolom</dd></div>
    </dl>
  </section>

  <section class="band band--white does" aria-labelledby="eig">
    <h2 id="eig" class="title-xl">Wat de hoes doet.</h2>
    <ul class="checks">
      {eigenschappen.map((e) => (<li><Icon name="check" /><span>{e}</span></li>))}
    </ul>
  </section>

  <section class="band band--sheet fiche" aria-labelledby="fiche">
    <div class="fiche-main">
      <table class="spec">
        <caption id="fiche">Technische fiche</caption>
        <thead><tr><th scope="col">Eigenschap</th><th scope="col">Norm</th><th scope="col">Waarde</th></tr></thead>
        <tbody>
          {hoesFiche.map(([k, n, v]) => (<tr><th scope="row">{k}</th><td class="norm">{n || '–'}</td><td>{v}</td></tr>))}
        </tbody>
      </table>
    </div>
    <div class="fiche-side">
      <h2 id="ond">Onderhoud</h2>
      <ul class="care" aria-labelledby="ond">
        {onderhoud.map((o) => (
          <li>
            <span class="sym" aria-hidden="true">
              {o.sym === '95' && <svg viewBox="0 0 40 40"><path d="M5 12h30l-3 22H8z" /><path d="M5 12c3-3 6 3 10 0s7 3 10 0 7 3 10 0" /><text x="20" y="29">95</text></svg>}
              {o.sym === 'bleach' && <svg viewBox="0 0 40 40"><path d="M20 6L36 34H4z" /><path d="M8 8l24 26M32 8L8 34" /></svg>}
              {o.sym === 'iron' && <svg viewBox="0 0 40 40"><path d="M6 30h28l-3-12H15c-5 0-8 5-9 12z" /><path d="M8 8l24 26M32 8L8 34" /></svg>}
              {o.sym === 'A' && <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="14" /><text x="20" y="26">A</text></svg>}
              {o.sym === 'dry' && <svg viewBox="0 0 40 40"><rect x="5" y="5" width="30" height="30" /><circle cx="20" cy="20" r="11" /><circle cx="20" cy="20" r="1.8" class="f" /></svg>}
            </span>
            <span>{o.label}</span>
          </li>
        ))}
      </ul>
      <p class="small">Ook bestand tegen: {ontsmetting}.</p>
      <div class="also">
        <h3>MMC 120 PU</h3>
        <p>Dezelfde kwaliteit, lichter gewicht. Voor plaatsen waar de hoes minder te lijden heeft, zoals de onrusthekkenbeschermer en het hoofdkussen MMC PUP 23.</p>
      </div>
    </div>
  </section>

  <QuoteBand lines={['Hoezen', 'op maat.']} text="De MMC 210 PU-hoes past ook op uw bestaande matrassen. Geef de maten door, of vraag eerst een staal van de stof." href={offerteUrl({ code: 'MMC 210 PU-hoes' })} label="Hoezen aanvragen" />
</Base>

<style>
  .head-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-m); margin-top: var(--space-m); }
  .facts div { display: grid; gap: 0.4rem; padding-top: 1.1rem; border-top: 2px solid var(--orange); }
  .facts dt { font-family: var(--display); font-stretch: 112%; font-weight: 700; font-size: clamp(2.4rem, 1rem + 3.4vw, 4.6rem); letter-spacing: -0.05em; line-height: 1; color: var(--white); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .facts .u { font-size: 0.45em; letter-spacing: 0; }
  .facts dd { margin: 0; color: var(--on-indigo-muted); }
  @media (max-width: 900px) { .facts { grid-template-columns: 1fr 1fr; } }

  .does { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--space-l) var(--space-xl); align-items: start; }
  .checks { list-style: none; padding: 0; display: grid; }
  .checks li { display: grid; grid-template-columns: 1.6rem 1fr; gap: 0.9rem; padding-block: 1rem; border-top: 1px solid var(--sheet-line); font-size: var(--step-1); line-height: 1.4; color: var(--ink); }
  .checks li:last-child { border-bottom: 1px solid var(--sheet-line); }
  .checks :global(svg) { width: 1.4rem; color: var(--orange-deep); margin-top: 0.2rem; }
  @media (max-width: 900px) { .does { grid-template-columns: 1fr; } }

  .fiche { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-l) var(--space-xl); align-items: start; }
  .fiche .spec caption { font-weight: 680; font-stretch: 112%; font-size: var(--step-3); letter-spacing: -0.04em; padding-bottom: 1.2rem; }
  .norm { color: var(--muted); font-size: var(--step--1); }
  .fiche-side h2 { font-size: var(--step-3); font-weight: 680; letter-spacing: -0.04em; margin-bottom: 1.2rem; }
  .care { list-style: none; padding: 0; display: grid; gap: 0.7rem; }
  .care li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.9rem; align-items: center; color: var(--ink); }
  .sym svg { width: 2.5rem; height: 2.5rem; fill: none; stroke: var(--ink); stroke-width: 1.6; }
  .sym text { fill: var(--ink); stroke: none; font: 600 10px var(--text-face); text-anchor: middle; }
  .sym .f { fill: var(--ink); }
  .small { margin-top: 1.25rem; font-size: var(--step--1); color: var(--muted); max-width: 60ch; }
  .also { margin-top: var(--space-l); padding: var(--space-m); background: var(--white); border-top: 2px solid var(--orange); }
  .also h3 { font-size: var(--step-1); font-weight: 680; margin-bottom: 0.5rem; }
  .also p { color: var(--muted); }
  @media (max-width: 900px) { .fiche { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .spec thead { display: none; } .spec tr { display: grid; padding: 0.7rem 0; background: var(--zipline) left bottom / 6px 5px repeat-x; } .spec th, .spec td { background: none !important; padding: 0.1rem 0; width: auto; } }
</style>
