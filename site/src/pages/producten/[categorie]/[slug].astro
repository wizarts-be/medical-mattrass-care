---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import ProductImage from '../../../components/ProductImage.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Icon from '../../../components/Icon.astro';
import { zichtbaar, categorie, categorieUrl, perCategorie, hoes, offerteUrl, fotoUrl } from '../../../lib/catalogus.mjs';
import { bedrijf } from '../../../data/site.mjs';

export function getStaticPaths() {
  return zichtbaar.filter((p) => !p.eigenPagina).map((p) => ({ params: { categorie: p.categorie, slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const c = categorie(p.categorie);
const h = hoes(p.hoes);
const verwant = perCategorie(p.categorie).filter((x) => x.slug !== p.slug).slice(0, 4);
const fotos = [
  ...(p.foto ? [{ src: p.foto, alt: p.fotoAlt }] : []),
  ...(p.extraFotos ?? []),
];
const jsonld = {
  '@context': 'https://schema.org', '@type': 'Product', name: p.naam, sku: p.code ?? undefined,
  description: [p.kort, ...(p.omschrijving ?? [])].join(' '),
  brand: { '@type': 'Brand', name: 'MMC' }, manufacturer: { '@type': 'Organization', name: bedrijf.naam },
  image: p.foto ? new URL(fotoUrl(p.foto), Astro.site).href : undefined, category: c?.lang ?? c?.naam,
};
---
<Base title={p.naam} description={`${p.naam}${p.code ? ` (${p.code})` : ''}: ${p.kort} Van Medical Mattress Care. Vraag uw offerte aan.`} jsonld={jsonld}>
  <PageHead title={p.naam} crumbs={[{ href: '/producten/', label: 'Producten' }, { href: categorieUrl(c), label: c.naam }, { label: p.naam }]}>
    <Fragment slot="above">{p.code && p.code !== p.naam && <p class="pcode">{p.code}</p>}</Fragment>
    <Fragment slot="below">
      <p class="kort">{p.kort}</p>
      {p.status === 'te-bevestigen' && <p class="note">Beschikbaarheid op aanvraag.</p>}
    </Fragment>
    <div class="head-cta">
      <a class="btn" href={offerteUrl(p)}>Offerte voor dit product <Icon name="arrow" /></a>
      <a class="btn btn--ghost" href={offerteUrl(p, 'staal')}>Staal aanvragen</a>
    </div>
  </PageHead>

  <div class="wrap layout">
    <div class="media">
      <figure class="main-frame" data-main>
        {fotos.length ? <ProductImage p={p} src={fotos[0].src} alt={fotos[0].alt} eager /> : <ProductImage p={p} />}
      </figure>
      {fotos.length > 1 && (
        <ul class="thumbs" aria-label="Meer foto's">
          {fotos.map((f, i) => (
            <li><button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-src={fotoUrl(f.src)} data-alt={f.alt}><img src={fotoUrl(f.src)} alt="" width="160" height="107" loading="lazy" /><span class="visually-hidden">Toon foto: {f.alt}</span></button></li>
          ))}
        </ul>
      )}
      {p.kleuren && (
        <div class="colours">
          <h2>Kleuren</h2>
          <ul>
            {p.kleuren.map((k: any, i: number) => (
              <li><button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-src={fotoUrl(k.foto)} data-alt={`${p.naam} in ${k.naam}`}><img src={fotoUrl(k.foto)} alt="" width="96" height="64" loading="lazy" /><span>{k.naam}</span></button></li>
            ))}
          </ul>
        </div>
      )}
      <div class="prose desc">
        {(p.omschrijving ?? []).map((t: string) => <p>{t}</p>)}
      </div>
    </div>

    <div class="specs">
      {p.specs?.length > 0 && (
        <table class="spec">
          <caption>Specificaties</caption>
          <tbody>
            {p.specs.map(([k, v]: string[]) => (<tr><th scope="row">{k}</th><td>{v}</td></tr>))}
            {p.badstof && <tr><th scope="row">Badstofhoes apart</th><td><span class="code">{p.badstof}</span></td></tr>}
          </tbody>
        </table>
      )}

      {p.varianten && (
        <table class="spec">
          <caption>Uitvoeringen</caption>
          <thead><tr>{p.varianten.kolommen.map((k: string) => <th scope="col">{k}</th>)}</tr></thead>
          <tbody>
            {p.varianten.rijen.map((r: string[]) => (
              <tr>{r.map((v, i) => (i === 0 ? <th scope="row"><span class="code">{v}</span></th> : <td>{v}</td>))}</tr>
            ))}
          </tbody>
        </table>
      )}

      <div class="badges">
        {h && (
          <a class="badge" href={p.hoes === '210' ? '/mmc-210-pu-hoes/' : undefined}>
            <strong>{h.naam}</strong><span>{h.regel}</span>
          </a>
        )}
        {p.maatwerk && (
          <a class="badge badge--orange" href="/maatwerk/">
            <strong>Maatwerk mogelijk</strong><span>Andere maat of opbouw? Wij maken het voor u.</span>
          </a>
        )}
      </div>

      {p.documenten?.length > 0 && (
        <ul class="docs">
          {p.documenten.map((d: any) => (<li><a href={d.href}><Icon name="download" />{d.label}</a></li>))}
        </ul>
      )}
      <a class="link-arrow fiche" href={offerteUrl(p, 'fiche')}>Technische fiche aanvragen <Icon name="arrow" /></a>
    </div>
  </div>

  {verwant.length > 0 && (
    <section class="wrap related" aria-labelledby="verwant">
      <h2 id="verwant">Ook in {c.naam.toLowerCase()}</h2>
      <ul class="grid-cards">{verwant.map((x) => <ProductCard p={x} />)}</ul>
    </section>
  )}

  <div class="sticky-cta" data-sticky>
    <span><strong>{p.naam}</strong>{p.code && p.code !== p.naam && <span class="scode"> {p.code}</span>}</span>
    <a class="btn btn--small" href={offerteUrl(p)}>Offerte aanvragen</a>
  </div>
</Base>

<script>
  const main = document.querySelector<HTMLElement>('[data-main] img');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('button[data-src]')];
  buttons.forEach((b) => b.addEventListener('click', () => {
    if (!main) return;
    main.src = b.dataset.src!;
    main.alt = b.dataset.alt ?? '';
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  }));
  // a quote bar appears once the header's buttons have scrolled away
  const bar = document.querySelector<HTMLElement>('[data-sticky]');
  const head = document.querySelector('.head-cta');
  if (bar && head) new IntersectionObserver(([e]) => bar.classList.toggle('is-on', !e.isIntersecting && e.boundingClientRect.top < 0)).observe(head);
</script>

<style>
  .pcode { font-weight: 500; letter-spacing: 0.04em; color: var(--muted); font-size: var(--step-0); margin-bottom: 0.9rem; font-variant-numeric: tabular-nums; }
  .kort { margin-top: 1.1rem; font-size: var(--step-1); color: var(--muted); max-width: 36ch; line-height: 1.45; }
  .note { margin-top: 0.8rem; color: var(--orange-deep); font-weight: 500; }
  .head-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: flex-start; }
  .head-cta .btn--ghost { color: var(--ink); border-color: var(--sheet-line); }

  .layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: var(--space-l) var(--space-xl); padding-block: var(--space-l) var(--space-xl); }
  .main-frame { aspect-ratio: 3 / 2; background: var(--sheet); overflow: hidden; }
  .thumbs, .colours ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
  .thumbs button, .colours button { padding: 0; border: 1px solid transparent; background: var(--sheet-deep); display: grid; }
  .thumbs button { width: 6.5rem; aspect-ratio: 3/2; overflow: hidden; }
  .thumbs img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: multiply; }
  .thumbs button[aria-pressed='true'], .colours button[aria-pressed='true'] { border-color: var(--indigo); box-shadow: 0 0 0 1px var(--indigo); }
  .colours { margin-top: var(--space-m); }
  .colours h2 { font-size: var(--step--1); font-family: var(--text-face); font-stretch: 100%; font-weight: 500; color: var(--muted); letter-spacing: 0; }
  .colours button { grid-template-columns: 3.5rem auto; align-items: center; gap: 0.6rem; padding-right: 0.8rem; background: var(--white); font-size: var(--step--1); color: var(--ink); text-align: left; }
  .colours img { width: 3.5rem; height: 2.5rem; object-fit: cover; }
  .desc { margin-top: var(--space-l); }
  .desc p:first-child { font-size: var(--step-1); line-height: 1.5; color: var(--ink); }

  .specs { display: grid; gap: var(--space-l); align-content: start; }
  .badges { display: grid; gap: 0.75rem; }
  .badge { display: grid; gap: 0.25rem; padding: 1.1rem 1.25rem; background: var(--indigo); color: var(--on-indigo); text-decoration: none; position: relative; }
  .badge strong { font-weight: 500; }
  .badge span { color: var(--on-indigo-muted); font-size: var(--step--1); }
  a.badge[href]::after { content: ''; position: absolute; right: 1.1rem; top: 1.2rem; width: 0.55rem; height: 0.55rem; border-top: 1.6px solid currentColor; border-right: 1.6px solid currentColor; transform: rotate(45deg); transition: transform 0.3s var(--ease-out); }
  a.badge[href]:hover::after { transform: translateX(3px) rotate(45deg); }
  .badge--orange { background: var(--white); color: var(--ink); box-shadow: inset 0 0 0 1px var(--sheet-line); }
  .badge--orange span { color: var(--muted); }
  .docs { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .docs a { display: inline-flex; gap: 0.6rem; align-items: center; color: var(--indigo); font-weight: 500; }
  .docs :global(svg) { width: 1.1rem; }
  .fiche { justify-self: start; color: var(--ink); }

  .related { padding-bottom: var(--space-xl); }
  .related h2 { font-size: var(--step-2); margin-bottom: 1rem; }
  .grid-cards { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr)); gap: clamp(0.75rem, 1.4vw, 1.25rem); }

  .sticky-cta {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: 0.7rem var(--gutter) max(0.7rem, env(safe-area-inset-bottom));
    background: var(--indigo-deep); color: var(--on-indigo);
    transform: translateY(110%); transition: transform 0.45s var(--ease-out);
  }
  .sticky-cta.is-on { transform: none; }
  .sticky-cta strong { font-weight: 500; }
  .sticky-cta .scode { font-size: var(--step--1); color: var(--on-indigo-muted); }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .sticky-cta .scode { display: none; } }
</style>
