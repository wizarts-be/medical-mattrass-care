---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { bedrijf } from '../data/site.mjs';

// One week, built from bedrijf.uren ("Maandag tot donderdag" + "Vrijdag"); weekend closed.
const [maDo, vr] = bedrijf.uren.map(([, u]) => u.split(' tot '));
const week = [
  { d: 'Maandag', n: 1, t: maDo },
  { d: 'Dinsdag', n: 2, t: maDo },
  { d: 'Woensdag', n: 3, t: maDo },
  { d: 'Donderdag', n: 4, t: maDo },
  { d: 'Vrijdag', n: 5, t: vr },
  { d: 'Zaterdag', n: 6, t: null },
  { d: 'Zondag', n: 0, t: null },
];
const urenKort = `Ma tot do ${maDo.join(' tot ')}, vr ${vr.join(' tot ')}`;
const route = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${bedrijf.showroom.straat}, ${bedrijf.showroom.postcode} ${bedrijf.showroom.gemeente}`)}`;
---
<Base title="Contact" description={`Contact Medical Mattress Care: ${bedrijf.telefoon}, ${bedrijf.email}. Showroom en afhalingen in ${bedrijf.showroom.gemeente}.`}>
  <PageHead
    title="Bel ons gerust."
    lede="Een vraag over een product, een maat of een levering? We helpen u liefst meteen."
    crumbs={[{ label: 'Contact' }]}
    compact
  />

  <!-- 1 · The three ways in, biggest first -->
  <section class="routes" aria-label="Bellen, mailen of schriftelijk">
    <div class="call">
      <h2 class="label">Bellen</h2>
      <a class="number" href={`tel:${bedrijf.telefoonHref}`}>{bedrijf.telefoon}</a>
      <p class="now" data-status data-week={JSON.stringify(week.map((w) => [w.n, w.t]))}>{urenKort}</p>
    </div>

    <div class="side">
      <div class="mail">
        <h2 class="label">Mailen</h2>
        <a class="address" href={`mailto:${bedrijf.email}`}>{bedrijf.email}</a>
        <button class="copy" type="button" data-copy={bedrijf.email} hidden>Kopieer adres</button>
      </div>
      <div class="write">
        <h2 class="label">Liever schriftelijk een prijs?</h2>
        <div class="cta">
          <a class="btn btn--blue" href="/offerte/">Offerte aanvragen <Icon name="arrow" /></a>
          <a class="btn btn--ghost" href="/offerte/?type=staal">Staal aanvragen</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · Visit: address left, the week right -->
  <section class="band band--indigo visit" aria-labelledby="visit-h">
    <div class="where">
      <h2 id="visit-h" class="title-xl">Kom langs in <em>{bedrijf.showroom.gemeente}.</em></h2>
      <p class="kind">{bedrijf.showroom.label}</p>
      <address>{bedrijf.showroom.straat}<br />{bedrijf.showroom.postcode} {bedrijf.showroom.gemeente}</address>
      <a class="btn btn--light" href={route} rel="noopener" target="_blank">Route plannen <Icon name="arrow" /></a>
    </div>

    <div class="when">
      <h3 class="label label--light">Openingsuren</h3>
      <dl class="week" data-weeklist>
        {week.map((w) => (
          <div data-day={w.n} class:list={{ closed: !w.t }}>
            <dt>{w.d}</dt>
            <dd>{w.t ? w.t.join(' tot ') : 'Gesloten'}</dd>
          </div>
        ))}
      </dl>
      <p class="seat">
        <strong>Maatschappelijke zetel</strong>
        {bedrijf.naam}, {bedrijf.straat}, {bedrijf.postcode} {bedrijf.gemeente}. Ondernemingsnummer {bedrijf.btw}.
      </p>
    </div>
  </section>
</Base>

<script>
  // Live status, in Belgian time, from the same week the page renders.
  const el = document.querySelector<HTMLElement>('[data-status]');
  if (el) {
    const week = new Map<number, [string, string] | null>(JSON.parse(el.dataset.week || '[]'));
    const toMin = (t: string) => { const [h, m] = t.split('.').map(Number); return h * 60 + (m || 0); };
    const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Brussels', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
    const day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday'));
    const now = Number(get('hour')) * 60 + Number(get('minute'));
    const names = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
    const today = week.get(day);
    let text: string; let open = false;
    if (today && now >= toMin(today[0]) && now < toMin(today[1])) {
      open = true; text = `Nu bereikbaar, tot ${today[1]}`;
    } else if (today && now < toMin(today[0])) {
      text = `Vandaag bereikbaar vanaf ${today[0]}`;
    } else {
      let n = 1; while (n < 8 && !week.get((day + n) % 7)) n++;
      const next = week.get((day + n) % 7);
      text = next ? `Gesloten. Weer bereikbaar ${n === 1 ? 'morgen' : names[(day + n) % 7]} vanaf ${next[0]}` : 'Gesloten';
    }
    const strong = document.createElement('strong');
    strong.textContent = `${text}. `;
    el.prepend(strong);
    el.classList.toggle('is-open', open);
    document.querySelector(`[data-weeklist] [data-day="${day}"]`)?.classList.add('is-today');
  }

  // Copy the mail address: mailto often opens nothing on a work PC.
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  if (btn && navigator.clipboard) {
    btn.hidden = false;
    const label = btn;
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(btn.dataset.copy!); label.textContent = 'Gekopieerd'; btn.classList.add('done'); }
      catch { label.textContent = 'Kopiëren lukte niet'; }
      setTimeout(() => { label.textContent = 'Kopieer adres'; btn.classList.remove('done'); }, 2200);
    });
  }
</script>

<style>
  /* ── Routes: straight under the short head; the number carries the page ── */
  .routes {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-l) var(--space-xl);
    padding: var(--space-m) var(--gutter) var(--space-xl); background: var(--white); align-items: start;
  }
  .label { font-size: var(--step--1); font-weight: 600; color: var(--muted); }
  .label--light { color: var(--on-indigo-muted); }

  .call { display: grid; gap: 0.9rem; justify-items: start; padding-top: 1.1rem; border-top: 2px solid var(--orange); }
  .number {
    font-family: var(--display); font-stretch: 112%; font-weight: 700; font-variant-numeric: tabular-nums;
    font-size: clamp(2.6rem, 0.8rem + 6.4vw, 7.5rem); letter-spacing: -0.05em; line-height: 0.92;
    color: var(--ink); text-decoration: none; white-space: nowrap; transition: color 0.25s var(--ease-out);
  }
  @media (hover: hover) { .number:hover { color: var(--orange-deep); } }
  .number:focus-visible { outline: 3px solid var(--orange); outline-offset: 6px; }
  .now { color: var(--muted); font-size: var(--step-0); line-height: 1.5; }
  .now strong { font-weight: 600; color: var(--ink); }
  .now.is-open strong { color: var(--orange-deep); }

  .side { display: grid; gap: var(--space-m); }
  .mail, .write { display: grid; gap: 0.8rem; justify-items: start; padding-top: 1.1rem; border-top: 1px solid var(--sheet-line); }
  .address { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; color: var(--ink); overflow-wrap: anywhere; text-decoration-color: rgb(38 26 102 / 0.25); text-underline-offset: 0.2em; }
  .address:hover { text-decoration-color: var(--orange); }
  .copy { font: inherit; font-size: var(--step--1); font-weight: 600; color: var(--muted); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-decoration-color: var(--sheet-line); text-underline-offset: 0.25em; }
  .copy:hover { color: var(--ink); text-decoration-color: var(--orange); }
  .copy.done { color: var(--ink); text-decoration: none; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  @media (max-width: 900px) { .routes { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .number { white-space: normal; } }

  /* ── Visit ── */
  .visit { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-l) var(--space-xl); align-items: start; }
  .where { display: grid; gap: 1rem; justify-items: start; }
  .where .title-xl { margin-bottom: 0.75rem; }
  .kind { color: var(--on-indigo-muted); font-size: var(--step--1); font-weight: 600; }
  address { font-style: normal; color: var(--white); font-size: var(--step-2); line-height: 1.3; letter-spacing: -0.015em; margin-bottom: 0.5rem; }

  .when { display: grid; gap: 0.9rem; }
  .week { margin: 0; display: grid; }
  .week div { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.7rem; border-top: 1px solid rgb(255 255 255 / 0.14); }
  .week dt, .week dd { color: var(--on-indigo-muted); }
  .week dd { margin: 0; font-variant-numeric: tabular-nums; }
  .week .closed :is(dt, dd) { opacity: 0.6; }
  .week .is-today :is(dt, dd) { color: var(--white); font-weight: 600; }
  .week .is-today dt::after { content: ' (vandaag)'; font-weight: 400; color: var(--orange); }
  .seat { margin-top: 0.75rem; color: var(--on-indigo-muted); font-size: var(--step--1); line-height: 1.6; }
  .seat strong { display: block; color: var(--white); font-weight: 600; }

  @media (max-width: 900px) { .visit { grid-template-columns: 1fr; } }
</style>
