---
// Calm reading section under the products: a title, an optional lede, then short headed blocks
// in an even grid. Used on category and product pages for the longer explanatory copy.
interface Blok { kop: string; tekst: string }
interface Props {
  titel: string;
  intro?: string;
  blokken: Blok[];
  tone?: 'white' | 'sheet';
  id?: string;
  size?: 'l' | 'm';
}
const { titel, intro, blokken, tone = 'white', id = 'meer', size = 'l' } = Astro.props;
// three blocks sit in one row; two or four read better as pairs
const cols = blokken.length === 3 ? 3 : Math.min(blokken.length, 2);
---
{blokken.length > 0 && (
  <section class:list={['band', `band--${tone}`, 'meer', `s-${size}`]} aria-labelledby={id}>
    <header class="meer-head">
      <span class="rule" aria-hidden="true"></span>
      <h2 id={id}>{titel}</h2>
      {intro && <p class="lede">{intro}</p>}
    </header>
    <div class="blokken" style={`--cols:${cols}`}>
      {blokken.map((b) => (
        <div class="blok">
          <h3>{b.kop}</h3>
          <p>{b.tekst}</p>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .s-m { padding-top: var(--space-l); }
  .meer-head { display: grid; gap: 1rem; justify-items: start; max-width: 48rem; margin-bottom: var(--space-l); }
  .rule { width: 4rem; height: 2px; background: var(--orange); }
  .meer-head h2 { font-size: clamp(2rem, 1rem + 2.6vw, 3.6rem); font-weight: 700; letter-spacing: -0.045em; line-height: 1; color: var(--ink); text-wrap: balance; }
  .s-m .meer-head h2 { font-size: clamp(1.7rem, 1rem + 1.8vw, 2.7rem); }
  .meer-head .lede { color: var(--muted); max-width: 52ch; }

  .blokken { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: var(--space-l) var(--space-xl); max-width: 82rem; }
  .blok { display: grid; gap: 0.7rem; align-content: start; padding-top: 1.1rem; border-top: 1px solid var(--sheet-line); }
  .blok h3 { font-family: var(--display); font-stretch: 112%; font-weight: 680; font-size: var(--step-1); letter-spacing: -0.025em; line-height: 1.15; color: var(--ink); }
  .blok p { color: var(--text); line-height: 1.6; max-width: 62ch; }

  @media (max-width: 1000px) { .blokken { grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr)); } }
  @media (max-width: 680px) { .blokken { grid-template-columns: 1fr; gap: var(--space-m); } }
</style>
