---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Icon from '../components/Icon.astro';
import { bedrijf } from '../data/site.mjs';
const feiten = [
  ['Opgericht', `${bedrijf.opgericht}, door ${bedrijf.zaakvoerder}`],
  ['Maatschappelijke zetel', `${bedrijf.straat}, ${bedrijf.postcode} ${bedrijf.gemeente}`],
  [bedrijf.showroom.label, `${bedrijf.showroom.straat}, ${bedrijf.showroom.postcode} ${bedrijf.showroom.gemeente}`],
  ['Productie', 'ISO 14001-gecertificeerd productiehuis, eigen groene stroom'],
  ['Fairsales', 'Gecertificeerd sinds 10.01.2016'],
  ['Ondernemingsnummer', bedrijf.btw],
];
---
<Base title="Over MMC" description="Medical Mattress Care is een Vlaams familiebedrijf dat sinds 2005 hygiënische, drukverlagende matrassen en hulpstukken maakt voor de zorg.">
  <PageHead title="Een Vlaams familiebedrijf," accent="sinds 2005." crumbs={[{ label: 'Over MMC' }]} tone="image" image={{ src: '/img/beeld/hero-2560.webp', mobile: '/img/beeld/hero-1280.webp', position: '30% 60%' }}>
    <a class="btn btn--light" href="/contact/">Contact en showroom <Icon name="arrow" /></a>
  </PageHead>

  <section class="band band--tall band--white story" aria-label="Ons verhaal">
    <p class="year" aria-hidden="true">2005</p>
    <div class="prose">
      <p class="first">Na jaren in de productie en verkoop van schuim zag Michel Marynissen dat hygiëne en kwaliteit in de zorg vaak te wensen overlieten.</p>
      <p>Samen met onderzoeksinstellingen ontwikkelde hij matrassen en hulpstukken die hygiënisch, drukverlagend en comfortabel zijn. Voor de zorg, en voor thuis.</p>
      <p>Vandaag levert Medical Mattress Care aan woonzorgcentra, ziekenhuizen en andere zorginstellingen. Bijna alle standaardproducten uit stock, en wat er niet bij zit, maken we op maat.</p>
      <p>Een jong, dynamisch en innoverend bedrijf, met de lage kostenstructuur van een familiebedrijf. Dat ziet u in de prijs.</p>
    </div>
  </section>

  <section class="band band--tall band--sheet" aria-labelledby="kort">
    <div class="split-head">
      <h2 id="kort" class="title-xl">MMC in het kort.</h2>
      <a class="link-arrow" href="/kwaliteit/">Kwaliteit en certificaten <Icon name="arrow" /></a>
    </div>
    <dl class="ruled" style="--cols:3">
      {feiten.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
    </dl>
  </section>

  <QuoteBand />
</Base>

<style>
  .story { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--space-xl); align-items: start; }
  .year { font-family: var(--display); font-stretch: 112%; font-weight: 700; font-size: clamp(5rem, 1rem + 13vw, 14rem); line-height: 0.82; letter-spacing: -0.06em; color: var(--orange); position: sticky; top: calc(var(--header-h) + 2rem); font-variant-numeric: tabular-nums; }
  .first { font-family: var(--display); font-stretch: 105%; font-weight: 500; font-size: var(--step-3); line-height: 1.12; letter-spacing: -0.03em; color: var(--ink); }
  .story .prose p:not(.first) { font-size: var(--step-1); line-height: 1.55; color: var(--text); }
  .split-head .link-arrow { justify-self: start; color: var(--ink); margin-bottom: 0.5rem; }
  .ruled dt { font-family: var(--text-face); font-stretch: 100%; font-weight: 500; font-size: var(--step--1); letter-spacing: 0; color: var(--muted); }
  .ruled dd { color: var(--ink); font-family: var(--display); font-stretch: 105%; font-weight: 560; font-size: var(--step-1); letter-spacing: -0.015em; line-height: 1.3; }
  @media (max-width: 860px) { .story { grid-template-columns: 1fr; gap: var(--space-m); } .year { position: static; } }
</style>
